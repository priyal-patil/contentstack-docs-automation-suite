{
  "id": "edit-an-environment",
  "project": "CMS",
  "module": "environment",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-environments/edit-an-environment",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)"
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "click",
      "target": "Environments (doc step)"
    },
    {
      "action": "click",
      "target": "Environment row action menu (doc step)"
    },
    {
      "action": "click",
      "target": "Edit Environment action (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Environment modal (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Edit Environment",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Environment Name (edit doc step)",
      "value": "env-edit-{unique}"
    },
    {
      "action": "enter",
      "target": "Base URL (edit doc step)",
      "value": "https://edited-{unique}.example.com"
    },
    {
      "action": "click",
      "target": "Save Environment (doc step)"
    }
  ]
}
