{
  "id": "edit-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/edit-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    {
      "action": "verify",
      "target": "Actions (doc step)",
      "expected": { "labelEquals": "Actions", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "vertical ellipsis (doc step)",
      "expected": { "rowContains": "AUTO-EDIT-" }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-EDIT-" } },
    { "action": "verify", "target": "Settings (doc step)", "expected": { "labelEquals": "Settings", "labelMatch": "equals" } },
    { "action": "click", "target": "Settings", "expected": { "rowContains": "AUTO-EDIT-" } },
    { "action": "enter", "target": "Description", "value": "AUTO-{unique5}" },
    { "action": "click", "target": "Update" },
    {
      "action": "verify",
      "target": "Actions (doc step)",
      "expected": { "labelEquals": "Actions", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "vertical ellipsis (doc step)",
      "expected": { "rowContains": "AUTO-EDIT-" }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-EDIT-" } },
    { "action": "verify", "target": "Edit (doc step)", "expected": { "labelEquals": "Edit", "labelMatch": "equals" } },
    { "action": "click", "target": "Edit", "expected": { "rowContains": "AUTO-EDIT-" } },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Save" }
  ]
}
