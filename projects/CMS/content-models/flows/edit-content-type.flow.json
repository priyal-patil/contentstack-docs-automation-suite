{
  "id": "edit-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/edit-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-" } },
    { "action": "verify", "target": "Settings", "expected": { "rowContains": "AUTO-" } },
    { "action": "click", "target": "Settings", "expected": { "rowContains": "AUTO-" } },
    { "action": "enter", "target": "Description", "value": "AUTO-{unique}" },
    { "action": "click", "target": "Update" },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-" } },
    { "action": "verify", "target": "Edit", "expected": { "rowContains": "AUTO-" } },
    { "action": "click", "target": "Edit", "expected": { "rowContains": "AUTO-" } },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Save" }
  ]
}
