{
  "id": "modular-blocks",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/modular-blocks",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Content Models"
    },
    {
      "action": "verify",
      "target": "Content Types"
    },
    {
      "action": "click",
      "target": "Open the content type you want to add Modular Blocks to."
    },
    {
      "action": "click",
      "target": "Insert a Field (doc step)"
    },
    {
      "action": "click",
      "target": "Modular Blocks (doc step)"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "+ New Block (doc step)"
    },
    {
      "action": "enter",
      "target": "Block Name (doc step)",
      "value": "Hero Banner"
    },
    {
      "action": "click",
      "target": "Create (doc step)"
    },
    {
      "action": "click",
      "target": "Insert a Field (inside block) (doc step)"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "click",
      "target": "Properties (Single Line Textbox) (doc step)"
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Hero Banner Title"
    },
    {
      "action": "click",
      "target": "+ New Block (doc step)"
    },
    {
      "action": "enter",
      "target": "Block Name (doc step)",
      "value": "Hero Banner 2"
    },
    {
      "action": "click",
      "target": "Create (doc step)"
    },
    {
      "action": "click",
      "target": "Insert a Field (inside block) (doc step)"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "click",
      "target": "Delete field (doc step)"
    },
    {
      "action": "click",
      "target": "Save (doc step)"
    }
  ]
}