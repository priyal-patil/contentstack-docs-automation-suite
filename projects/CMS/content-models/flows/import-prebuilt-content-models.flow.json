{
  "id": "import-prebuilt-content-models",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/import-prebuilt-content-models",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models", "expected": { "within": "Left Navigation" } },
    { "action": "click", "target": "+ New Content Type" },
    { "action": "click", "target": "Use Prebuilt" },

    { "action": "verify", "target": "Add Content Model", "expected": { "within": "Modal" } },
    { "action": "verify", "target": "About Us Page", "expected": { "within": "Modal" } },
    { "action": "click", "target": "About Us Page", "expected": { "within": "Modal" } },
    {
      "action": "verify",
      "target": "Defines the structure, fields, and schema to design the About Us page of your website.",
      "expected": { "within": "Modal" }
    },
    { "action": "verify", "target": "Import", "expected": { "within": "Modal" } },
    { "action": "click", "target": "Import", "expected": { "within": "Modal" } },

    { "action": "verify", "target": "Stack Name" },
    {
      "action": "verify",
      "target": "Import Content Model to Stack"
    },
    { "action": "verify", "target": "Import Content Model" },
    { "action": "click", "target": "Import Content Model" },

    { "action": "verify", "target": "View Content Models", "expected": { "timeoutMs": 300000 } },
    { "action": "click", "target": "View Content Models" }
  ]
}


