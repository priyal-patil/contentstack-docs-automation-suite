{
  "id": "copy-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/copy-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-" } },
    { "action": "verify", "target": "Copy Content Type", "expected": { "rowContains": "AUTO-" } },
    { "action": "click", "target": "Copy Content Type", "expected": { "rowContains": "AUTO-" } },
    { "action": "verify", "target": "Copy", "expected": { "within": "Modal" } },
    { "action": "enter", "target": "Name", "value": "AUTO-{unique5}", "expected": { "within": "Modal" } },
    { "action": "enter", "target": "Description", "value": "AUTO-{unique5}", "expected": { "within": "Modal" } },
    { "action": "click", "target": "Copy", "expected": { "within": "Modal" } },
    { "action": "verify", "target": "Save" }
  ]
}
