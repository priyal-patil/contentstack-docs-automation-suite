{
  "id": "copy-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/copy-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "within": "Left Navigation", "labelEquals": "Content Models", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Content Models" },
    {
      "action": "verify",
      "target": "Actions (doc step)",
      "expected": { "labelEquals": "Actions", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "vertical ellipsis (doc step)",
      "expected": { "rowContains": "AUTO-COPY-" }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-COPY-" } },
    { "action": "verify", "target": "Copy Content Type (doc step)" },
    { "action": "click", "target": "Copy Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Copy Content Type modal (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Copy Content Type" }
    },
    {
      "action": "verify",
      "target": "Copy (doc step)",
      "expected": { "within": "Modal", "labelEquals": "Copy", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Copy", "expected": { "within": "Modal" } }
  ]
}
