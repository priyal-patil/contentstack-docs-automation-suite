{
  "id": "add-a-field-visibility-rule-part-1",
  "project": "CMS",
  "module": "content-models",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/add-a-field-visibility-rule",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    {
      "action": "verify",
      "target": "Actions (doc step)",
      "expected": { "labelEquals": "Actions", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "vertical ellipsis (doc step)",
      "expected": { "rowContains": "AUTO-FVR1-" }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-FVR1-" } },
    { "action": "verify", "target": "Edit (doc step)" },
    { "action": "click", "target": "Edit (doc step)" },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Date (doc step)" },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Single Line Textbox (doc step)" },
    { "action": "enter", "target": "Display Name (doc step)", "value": "Archive Notification" },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Multi Line Textbox (doc step)" },
    { "action": "enter", "target": "Display Name (doc step)", "value": "Body" },
    { "action": "click", "target": "Save (doc step)" },
    {
      "action": "verify",
      "target": "Field Visibility Rules (doc step)",
      "expected": { "labelEquals": "Field Visibility Rules", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Field Visibility Rules (doc step)" },
    {
      "action": "verify",
      "target": "Create New Rule (doc step)",
      "expected": { "warnOnly": true }
    },
    { "action": "click", "target": "Create New Rule (doc step)" },
    { "action": "click", "target": "Operand Field (FVR) (doc step)" },
    { "action": "click", "target": "Date (FVR option) (doc step)" },
    { "action": "click", "target": "Condition operator (FVR) (doc step)" },
    { "action": "click", "target": "Before (FVR option) (doc step)" },
    { "action": "enter", "target": "Expected Value (FVR) (doc step)", "value": "12-31-2024" },
    { "action": "click", "target": "Action type Show (FVR) (doc step)" },
    { "action": "click", "target": "Show (FVR option) (doc step)" },
    { "action": "click", "target": "Target field (FVR) (doc step)" },
    { "action": "click", "target": "Archive Notification (FVR option) (doc step)" },
    { "action": "click", "target": "Add action (FVR) (doc step)" },
    { "action": "click", "target": "Action type Hide (FVR) (doc step)" },
    { "action": "click", "target": "Hide (FVR option) (doc step)" },
    { "action": "click", "target": "Target field 2 (FVR) (doc step)" },
    { "action": "click", "target": "Body (FVR option) (doc step)" },
    {
      "action": "verify",
      "target": "Save rule (FVR) (doc step)",
      "expected": { "labelEquals": "Save", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Save rule (FVR) (doc step)" },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": { "labelEquals": "Save and Close", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Save and Close (doc step)" }
  ]
}
