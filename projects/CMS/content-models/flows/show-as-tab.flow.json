{
  "id": "show-as-tab",
  "project": "CMS",
  "module": "content-models",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/show-as-tab",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    {
      "action": "verify",
      "target": "Actions (doc step)",
      "expected": { "labelEquals": "Actions", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "vertical ellipsis (doc step)",
      "expected": { "rowContains": "AUTO-TAB-" }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-TAB-" } },
    {
      "action": "verify",
      "target": "Edit (doc step)",
      "expected": { "labelEquals": "Edit", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Edit", "expected": { "rowContains": "AUTO-TAB-" } },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Group (doc step)" },
    {
      "action": "verify",
      "target": "Properties (doc step)",
      "expected": { "labelEquals": "Properties", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Properties (doc step)" },
    {
      "action": "verify",
      "target": "Advanced (doc step)",
      "expected": { "labelEquals": "Advanced", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Advanced (doc step)" },
    
    {
      "action": "verify",
      "target": "Show as Tab toggle on (doc step)",
      "expected": { "labelEquals": "Show as Tab" }
    },
    { "action": "click", "target": "Show as Tab (doc step)" },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": { "labelEquals": "Save and Close", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Save and Close (doc step)" }
  ]
}
