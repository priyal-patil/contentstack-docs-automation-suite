{
  "id": "html-based-rich-text-editor-part-2",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/rich-text-editor",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    { "action": "click", "target": "New Content Type" },
    { "action": "verify", "target": "Create New" },
    { "action": "click", "target": "Create New", "expected": { "modalTitle": "Create New Content Type" } },
    { "action": "enter", "target": "Name", "value": "AUTO-RTE-EMBED-{unique5}" },
    { "action": "enter", "target": "Description", "value": "AUTO-RTE-EMBED-{unique5}" },
    { "action": "click", "target": "Single (Type)" },
    { "action": "click", "target": "Save and proceed" },

    { "action": "click", "target": "Add field (+)" },
    { "action": "verify", "target": "Rich Text Editor" },
    { "action": "click", "target": "Rich Text Editor" },

    { "action": "click", "target": "Advanced (doc step)" },
    { "action": "click", "target": "Advanced (Editor Type) (doc step)" },

    { "action": "verify", "target": "Options (doc step)" },
    { "action": "verify", "target": "Embed Object(s) (doc step)" },
    { "action": "click", "target": "Embed Object(s) Toggle (doc step)" },

    { "action": "click", "target": "Select Object(s) (open modal) (doc step)" },
    { "action": "click", "target": "First content type checkbox (doc step)" },

    { "action": "verify", "target": "Add Content Type(s) (doc step)" },
    { "action": "click", "target": "Add Content Type(s) (doc step)" },

    { "action": "click", "target": "Save (doc step)" }
  ]
}

