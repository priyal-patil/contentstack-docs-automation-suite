{
  "id": "switch-between-alphabetical-and-label-view",
  "project": "CMS",
  "module": "content-models",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/switch-between-alphabetical-and-label-view",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
