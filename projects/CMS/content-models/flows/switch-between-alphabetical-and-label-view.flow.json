    },
    {
      "action": "verify",
      "target": "Content Types"
    },
    {
      "action": "verify",
      "target": "All Labels (doc step)",
      "expected": {
        "labelEquals": "All Labels",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Any label from list (doc step)"
    },
    {
      "action": "verify",
      "target": "Any label from list (doc step)"
    }
  ]
}
