{
  "id": "create-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/create-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "within": "Left Navigation", "labelEquals": "Content Models", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelEquals": "New Content Type", "labelMatch": "equals" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Create New (doc step)",
      "expected": { "labelEquals": "Create New", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelEquals": "Use Prebuilt", "labelMatch": "equals" }
    },
    {
      "action": "click",
      "target": "Create New (doc step)",
      "expected": { "modalTitle": "Create New Content Type" }
    },
    {
      "action": "verify",
      "target": "Create New Content Type modal (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Create New Content Type" }
    },
    {
      "action": "verify",
      "target": "Name (doc step)",
      "expected": { "within": "Modal", "labelEquals": "Name", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Create New Content Type Unique ID field label (doc step)",
      "expected": { "within": "Modal", "labelEquals": "Unique ID", "labelMatch": "equals" },
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Description (doc step)",
      "expected": { "within": "Modal", "labelEquals": "Description", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Single (Type doc step)",
      "expected": { "labelEquals": "Single", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Multiple (Type doc step)",
      "expected": { "labelEquals": "Multiple", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Save and proceed (doc step)",
      "expected": { "labelEquals": "Save and proceed", "labelMatch": "equals" }
    },
    { "action": "enter", "target": "Name (doc step)", "value": "AUTO-{unique5}" },
    { "action": "enter", "target": "Description (doc step)", "value": "AUTO-{unique5}" },
    { "action": "select", "target": "Type (doc step)", "value": "Single" },
    { "action": "click", "target": "Save and proceed (doc step)" },
    {
      "action": "verify",
      "target": "Content Type Builder (doc step)",
      "expected": { "labelEquals": "Title", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Insert a field (doc step)",
      "expected": { "documentedFields": ["Insert a field"], "visible": true }
    },
    {
      "action": "verify",
      "target": "Properties cog (doc step)"
    },
    {
      "action": "verify",
      "target": "Save (doc step)",
      "expected": { "labelEquals": "Save", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": { "labelEquals": "Save and Close", "labelMatch": "equals" }
    },
    { "action": "click", "target": "Insert a field (doc step)" },
    { "action": "click", "target": "Properties cog (doc step)" },
    { "action": "click", "target": "Save (doc step)" }
  ]
}
