{
  "id": "create-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/create-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    { "action": "click", "target": "Create New Content Type" },
    { "action": "click", "target": "Create New", "expected": { "modalTitle": "Create New Content Type" } },
    { "action": "enter", "target": "Name", "value": "AUTO-{unique}" },
    { "action": "enter", "target": "Description", "value": "AUTO-{unique}" },
    { "action": "select", "target": "Type", "value": "Single" },
    { "action": "click", "target": "Save and proceed" },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Save" }
  ]
}
