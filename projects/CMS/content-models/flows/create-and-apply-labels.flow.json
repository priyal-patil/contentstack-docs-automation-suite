{
  "id": "create-and-apply-labels",
  "project": "CMS",
  "module": "content-models",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/create-and-apply-labels",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "within": "Left Navigation",
      "warnOnly": true,
      "alwaysWarn": true,
      "warnMessage": "Doc says Content Models is in the Left Navigation but it is in the top nav — update the doc.",
      "expected": {
        "labelEquals": "Content Models",
        "labelMatch": "equals"
      }
    },
    {
      "action": "click",
      "target": "Content Models (doc step)"
    },
    {
      "action": "click",
      "target": "First Content Type row (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Apply Label dropdown (doc step)",
      "expected": {
        "labelEquals": "Apply Label",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Apply Label dropdown (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "click",
      "target": "+ New Label option (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Name field label (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "equals"
      }
    },
    {
      "action": "verify",
      "target": "Nest Label Under field label (doc step)",
      "expected": {
        "labelEquals": "Nest Label Under",
        "labelMatch": "equals"
      }
    },
    {
      "action": "verify",
      "target": "Create button (doc step)",
      "expected": {
        "labelEquals": "Create",
        "labelMatch": "equals"
      }
    },
    {
      "action": "verify",
      "target": "Create and Apply button (doc step)",
      "expected": {
        "labelEquals": "Create & Apply",
        "labelMatch": "equals"
      }
    },
    {
      "action": "enter",
      "target": "Name field (doc step)",
      "value": "AUTO-label-{unique5}"
    },
    {
      "action": "click",
      "target": "Create and Apply button (doc step)",
      "timeoutMs": 60000
    }
  ]
}