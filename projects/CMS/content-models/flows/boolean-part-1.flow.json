{
  "id": "boolean-part-1",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/boolean",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    { "action": "verify", "target": "Content Types" },
    { "action": "click", "target": "New Content Type" },
    { "action": "verify", "target": "Create New" },
    { "action": "click", "target": "Create New", "expected": { "modalTitle": "Create New Content Type" } },
    { "action": "enter", "target": "Name", "value": "Boolean-Demo-{unique}" },
    { "action": "enter", "target": "Description", "value": "Boolean-Demo-{unique}" },
    { "action": "click", "target": "Single (Type)" },
    { "action": "click", "target": "Save and proceed" },
    { "action": "click", "target": "Insert a field" },
    { "action": "click", "target": "Boolean (doc step)" },
    { "action": "click", "target": "Builder area (dismiss properties)" },
    { "action": "click", "target": "Properties (Boolean) (doc step)", "nth": 1 },
    { "action": "enter", "target": "Display Name (doc step)", "value": "I agree" },
    { "action": "enter", "target": "Help text (doc step)", "value": "Visit our website to learn more about our privacy policies" },
    { "action": "enter", "target": "Instruction value (doc step)", "value": "Confirm by checking if you have read and agreed to our Terms and Conditions" },
    { "action": "click", "target": "Save and Close" }
  ]
}
