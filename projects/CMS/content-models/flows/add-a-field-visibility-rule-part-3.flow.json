    { "action": "click", "target": "+ Add Another Rule (doc step)" },
    { "action": "click", "target": "Operand Field 2 (FVR) (doc step)" },
    { "action": "click", "target": "Condition operator 2 (FVR) (doc step)" },
    { "action": "click", "target": "Action type Show 2 (FVR) (doc step)" },
    { "action": "click", "target": "Show (FVR option) (doc step)" },
    { "action": "click", "target": "Target field 2 (FVR) (doc step)" },
    {
      "action": "verify",
      "target": "Save rule (FVR) (doc step)",
      "expected": { "labelEquals": "Save", "labelMatch": "equals" }
