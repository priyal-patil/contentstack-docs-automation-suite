{
  "id": "export-content-type",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/export-a-content-type",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models" },
    {
      "action": "verify",
      "target": "Actions (doc step)",
      "expected": { "labelEquals": "Actions", "labelMatch": "equals" }
    },
    {
      "action": "verify",
      "target": "vertical ellipsis (doc step)",
      "expected": { "rowContains": "AUTO-EXPORT-" }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "AUTO-EXPORT-" } },
    { "action": "verify", "target": "Export (doc step)" },
    { "action": "click", "target": "Export (doc step)" }
  ]
}
