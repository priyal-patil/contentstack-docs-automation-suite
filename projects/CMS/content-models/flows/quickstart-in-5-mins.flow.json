{
  "id": "quickstart-in-5-mins",
  "project": "CMS",
  "module": "content-models",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/quickstart-in-5-mins",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS" },
    {
      "action": "verify",
      "target": "+ New Stack (doc step)",
