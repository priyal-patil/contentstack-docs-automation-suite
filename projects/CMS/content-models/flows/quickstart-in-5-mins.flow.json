      "expected": { "modalTitle": "Create New Content Type" }
    },
    {
      "action": "verify",
      "target": "Create New Content Type modal (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Create New Content Type" }
    },
    {
      "action": "verify",
      "target": "Name (doc step)",
      "expected": { "labelEquals": "Name", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Description (doc step)",
      "expected": { "labelEquals": "Description", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Single (Type doc step)",
      "expected": { "labelEquals": "Single", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Multiple (Type doc step)",
      "expected": { "labelEquals": "Multiple", "labelMatch": "contains" }
    },
    {
      "action": "verify",
