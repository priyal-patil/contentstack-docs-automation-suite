        "within": "Top Bar",
        "withinStrict": false,
        "labelEquals": "New Stack",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "+ New Stack (doc step)" },
    {
      "action": "verify",
      "target": "Create New (doc step)",
      "expected": { "labelEquals": "Create New", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelEquals": "Use Prebuilt", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Create New (doc step)" },
    {
      "action": "verify",
      "target": "Name (create stack doc step)",
      "expected": { "labelEquals": "Name", "labelMatch": "contains" }
    },
    {
      "action": "enter",
      "target": "Name (create stack doc step)",
      "value": "My Website {unique5}"
    },
    {
      "action": "enter",
      "target": "Description (create stack doc step)",
      "value": "Content for my website {unique5}"
    },
    {
      "action": "verify",
      "target": "Master Language (create stack doc step)",
      "expected": { "labelEquals": "Master Language", "labelMatch": "contains" }
