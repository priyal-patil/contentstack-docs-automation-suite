    { "action": "click", "target": "Builder area (dismiss properties)" },
    { "action": "click", "target": "Save and Close (doc step)" },

    { "action": "click", "target": "Settings (doc step)" },
    {
      "action": "verify",
      "target": "Environments from left nav (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Environments",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Environments from left nav (doc step)" },
    {
      "action": "verify",
      "target": "Environments page (doc step)",
      "expected": { "labelEquals": "Environments", "labelMatch": "contains" }
    },
    { "action": "click", "target": "New Environment (doc step)" },
    {
      "action": "verify",
      "target": "Create Environment modal (doc step)",
      "expected": { "labelEquals": "Create Environment", "labelMatch": "contains" }
    },
    {
      "action": "enter",
      "target": "Environment Name (doc step)",
      "value": "production"
    },
    {
      "action": "verify",
      "target": "Environment Label Color (doc step)",
      "expected": { "labelEquals": "Environment Label Color", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Environment color picker (doc step)" },
    {
      "action": "enter",
      "target": "Base URL (doc step)",
      "value": "http://localhost:8000"
    },
    {
      "action": "verify",
      "target": "Language (environment create doc step)",
      "expected": { "labelEquals": "Language", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Create Environment (doc step)" },

    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)" },
    {
      "action": "verify",
      "target": "Entries page (doc step)",
      "expected": { "labelEquals": "Entries", "labelMatch": "contains" }
    },
    { "action": "click", "target": "New Entry (doc step)" },
    {
      "action": "verify",
      "target": "Select Content Type modal title (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Select Content Type", "warnOnly": true }
    },
    { "action": "click", "target": "About Us content type row (doc step)", "expected": { "warnOnly": true } },
    {
      "action": "verify",
      "target": "Proceed (Select Content Type modal) (doc step)",
      "expected": { "labelEquals": "Proceed", "labelMatch": "contains", "warnOnly": true }
    },
    { "action": "click", "target": "Proceed (Select Content Type modal) (doc step)", "expected": { "warnOnly": true } },
    {
      "action": "enter",
      "target": "Entry Title (doc step)",
      "value": "Contentstack"
    },
    {
      "action": "enter",
      "target": "Entry URL (quickstart doc step)",
      "value": "/about"
    },
    { "action": "click", "target": "Save (doc step)" },

    {
      "action": "verify",
      "target": "Publish (bottom-right) (doc step)",
      "expected": { "labelEquals": "Publish", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Publish (bottom-right) (doc step)" },
    {
      "action": "verify",
      "target": "Publish Entry modal (doc step)",
      "timeoutMs": 90000,
      "expected": { "modalTitle": "Publish Entry" }
    },
    {
      "action": "verify",
      "target": "Publish Entry Select Environment label (doc step)",
      "expected": { "labelEquals": "Select Environment", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Publish Entry production environment label (doc step)",
      "expected": { "labelEquals": "production", "labelMatch": "contains" }
    },
    { "action": "click", "target": "First Environment option (doc step)" },
    {
      "action": "verify",
      "target": "Publish Entry Select Language label (doc step)",
      "expected": { "labelEquals": "Select Language", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Publish Entry English United States language label (doc step)",
      "expected": { "labelEquals": "English - United States", "labelMatch": "contains" }
    },
    { "action": "click", "target": "First Language option (doc step)" },
    {
      "action": "verify",
      "target": "Publish Entry Publish schedule label (doc step)",
      "expected": { "labelEquals": "Publish", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Publish Entry Now option (doc step)",
      "expected": { "labelEquals": "Now", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Publish Entry Later option (doc step)",
      "expected": { "labelEquals": "Later", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Now (doc step)" },
    {
      "action": "verify",
      "target": "Send (doc step)",
      "expected": { "labelEquals": "Send", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Send (doc step)" },

    { "action": "click", "target": "Entry Information sidebar tab (doc step)" },
    {
      "action": "verify",
      "target": "Entry UID row in info panel (doc step)",
      "expected": { "labelEquals": "Entry UID", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Content Type UID row in info panel (doc step)",
      "expected": { "labelEquals": "Content Type UID", "labelMatch": "contains" }
    }
  ]
