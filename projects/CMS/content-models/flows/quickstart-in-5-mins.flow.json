    { "action": "click", "target": "Stack Color swatch (doc step)" },
    { "action": "click", "target": "Create (doc step)" },

    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "within": "Left Navigation", "labelMatch": "Content Model" }
