      "expected": { "labelEquals": "Save and proceed", "labelMatch": "contains" }
    },
    { "action": "enter", "target": "Name (doc step)", "value": "About Us" },
    {
      "action": "enter",
      "target": "Description (doc step)",
      "value": "Organizational details {unique5}"
    },
    { "action": "select", "target": "Type (doc step)", "value": "Single" },
    { "action": "click", "target": "Save and proceed (doc step)" },
    {
      "action": "verify",
      "target": "Content Type Builder (doc step)",
      "expected": { "labelEquals": "Title", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Insert a field (doc step)",
      "expected": { "documentedFields": ["Insert a field"], "visible": true }
    },
    {
      "action": "verify",
      "target": "Save (doc step)",
      "expected": { "labelEquals": "Save", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": { "labelEquals": "Save and Close", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Insert a field (doc step)" },
