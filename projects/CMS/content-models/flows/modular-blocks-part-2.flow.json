{
  "id": "modular-blocks-part-2",
  "project": "CMS",
  "module": "content-models",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/modular-blocks",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Content Models"
    },
    {
      "action": "verify",
      "target": "Content Types"
    },
    {
      "action": "click",
      "target": "New Content Type"
    },
    {
      "action": "click",
      "target": "Create New (doc step)"
    },
    {
      "action": "enter",
      "target": "Name",
      "value": "Page-{unique5}"
    },
    {
      "action": "enter",
      "target": "Description",
      "value": "Page-{unique5}"
    },
    {
      "action": "click",
      "target": "Save and proceed"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Multi Line Textbox (doc step)"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Properties (Multi Line Textbox) (doc step)"
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Intro"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "click",
      "target": "Properties (Metadata) (doc step)",
      "nth": 2
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Metadata"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Global (SEO) (doc step)"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Modular Blocks (doc step)"
    },
    {
      "action": "click",
      "target": "Properties (Modular Blocks) (doc step)"
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Page Components"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "+ New Block (doc step)"
    },
    {
      "action": "enter",
      "target": "Block Name (doc step)",
      "value": "Banner"
    },
    {
      "action": "click",
      "target": "Create (doc step)"
    },
    {
      "action": "click",
      "target": "+ New Block (doc step)"
    },
    {
      "action": "enter",
      "target": "Block Name (doc step)",
      "value": "Quote"
    },
    {
      "action": "click",
      "target": "Create (doc step)"
    },
    {
      "action": "click",
      "target": "+ New Block (doc step)"
    },
    {
      "action": "enter",
      "target": "Block Name (doc step)",
      "value": "Sections"
    },
    {
      "action": "click",
      "target": "Create (doc step)"
    },
    {
      "action": "click",
      "target": "Save (doc step)"
    }
  ]
}