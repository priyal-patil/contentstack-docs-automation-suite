    {
      "action": "verify",
      "target": "Task filter panel section headings match use task filter doc (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Tasks filter Action values Approved Pending Rejected in left sidebar (doc step)",
      "timeoutMs": 60000
    }
  ]
