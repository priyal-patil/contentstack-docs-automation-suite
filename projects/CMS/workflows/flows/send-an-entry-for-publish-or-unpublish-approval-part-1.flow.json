{
  "id": "send-an-entry-for-publish-or-unpublish-approval-part-1",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/use-workflows/send-an-entry-for-publish-or-unpublish-approval",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Top Bar",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Entry row (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entry editor Status tab icon (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Entry editor right sidebar",
        "withinStrict": true
      }
    },
    {
      "action": "click",
      "target": "Entry editor Status tab icon (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Entry Status panel title (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Entry editor right sidebar",
        "withinStrict": true,
        "labelEquals": "Entry Status",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Publish Rules heading in Entry Status panel (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Entry editor right sidebar",
        "withinStrict": true,
        "labelEquals": "Publish Rules",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Request Approval button visible in Publish Rules section (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Entry editor right sidebar",
        "withinStrict": true,
        "labelEquals": "Request Approval",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Request Approval button in Publish Rules section (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Publish Rules section publish request status after Request Approval (doc step)",
      "optional": true,
      "timeoutMs": 30000
    }
  ]
}
