{
  "id": "delete-a-workflow",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-workflows-and-publish-rules/delete-a-workflow",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Workflows in settings left nav (doc step)",
      "expected": {
        "within": "Left Navigation",
        "labelEquals": "Workflows",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Workflows in settings left nav (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Workflow page title (doc step)",
      "expected": {
        "labelEquals": "Workflow",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflows tab selected Workflow (doc step)",
      "expected": {
        "labelEquals": "Workflows",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow listing Name column header (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "hover",
      "target": "Workflow listing first workflow row hover for delete icon (doc step)",
      "timeoutMs": 60000
    },
    { "action": "click", "target": "Workflow listing first workflow row Delete icon (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Workflow delete confirmation Proceed button (doc step)",
      "optional": true,
      "expected": {
        "within": "Modal",
        "labelEquals": "Proceed",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Workflow delete confirmation Proceed button (doc step)",
      "optional": true,
      "timeoutMs": 30000
    },
    {
      "action": "warn",
      "value": "Doc: API reference — delete a workflow via API is separate from the UI steps above. If Proceed was skipped (optional), confirm delete manually in a test stack."
    }
  ]
}
