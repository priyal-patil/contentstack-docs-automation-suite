{
  "id": "send-an-entry-for-edit-access-approval",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/use-workflows/send-an-entry-for-edit-access-approval",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Request Edit Access button visible at entry page bottom (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "labelEquals": "Request Edit Access",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Request Edit Access button at entry page bottom (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Request Edit Access dialog title (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Modal",
        "withinStrict": true,
        "labelEquals": "Request Edit Access",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Add comments field in Request Edit Access modal (doc step)",
      "value": "Doc edit access approval request {unique}",
      "timeoutMs": 60000
    },
    { "action": "click", "target": "Send Request button in Request Edit Access modal (doc step)", "timeoutMs": 60000 }
  ]
}
