{
  "id": "get-started-with-workflows",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-workflows-and-publish-rules/get-started-with-workflows",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Top Bar",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Entry row (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entry editor Status tab icon (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Entry editor right sidebar",
        "withinStrict": true
      }
    },
    {
      "action": "click",
      "target": "Entry editor Status tab icon (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Entry Status panel title (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "labelEquals": "Entry Status",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow Details section heading in Entry Status panel (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "labelEquals": "Workflow Details",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Current stage assignees due date under Workflow Details in Entry Status panel (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Publish Rules heading in Entry Status panel (doc step)",
      "optional": true,
      "timeoutMs": 30000,
      "expected": {
        "labelEquals": "Publish Rules",
        "labelMatch": "contains"
      }
    }
  ]
}
