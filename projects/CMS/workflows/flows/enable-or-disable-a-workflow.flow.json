{
  "id": "enable-or-disable-a-workflow",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-workflows-and-publish-rules/enable-or-disable-a-workflow",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Workflows in settings left nav (doc step)",
      "expected": {
        "labelEquals": "Workflows",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Workflows in settings left nav (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Workflow page title (doc step)",
      "expected": {
        "labelEquals": "Workflow",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflows tab selected Workflow (doc step)",
      "expected": {
        "labelEquals": "Workflows",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow listing Name column header (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "hover",
      "target": "Workflow listing first workflow row hover for Power icon (doc step)",
      "timeoutMs": 60000
    },
    { "action": "click", "target": "Workflow listing first workflow row Power icon (doc step)", "timeoutMs": 60000 },
    {
      "action": "warn",
      "value": "Doc: Alternatively, enable or disable the workflow via the workflow page using the Enable Workflow control."
    },
    { "action": "click", "target": "Workflow listing first workflow row link (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Enable Workflow label (doc step)",
      "expected": {
        "labelEquals": "Enable Workflow",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow editor Save button label (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Workflow editor Save button (doc step)", "timeoutMs": 90000 },
    {
      "action": "warn",
      "value": "Doc: API reference — enable/disable workflow via API is separate from the UI steps above."
    }
  ]
}
