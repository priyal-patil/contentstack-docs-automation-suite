{
  "id": "revoke-edit-access-for-an-entry",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/use-workflows/revoke-edit-access-for-an-entry",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)" },
    { "action": "click", "target": "First Entry row (doc step)" },
    {
      "action": "verify",
      "target": "Entry editor Status tab (doc step)",
      "expected": { "within": "Status panel" }
    },
    {
      "action": "verify",
      "target": "Entry editor Status tab Status icon (doc step)",
      "expected": { "within": "Status panel" }
    },
    { "action": "click", "target": "Entry editor Status tab (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Entry editor Workflow Details heading (doc step)",
      "expected": {
        "within": "Status panel",
        "labelEquals": "Workflow Details",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Entry workflow Change link (doc step)",
      "expected": {
        "within": "Status panel",
        "labelEquals": "Change",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Users to whom edit access is granted section heading (doc step)",
      "expected": {
        "within": "Status panel",
        "labelEquals": "Users to whom edit access is granted",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Revoke edit access remove user first chip button (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Revoke edit access View All link (doc step)",
      "optional": true,
      "expected": {
        "within": "Status panel",
        "labelEquals": "View All",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Revoke edit access View All link (doc step)",
      "optional": true,
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "All Other users modal title (doc step)",
      "optional": true,
      "expected": {
        "within": "Modal",
        "labelEquals": "All Other users",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Revoke edit access remove user first chip in All Other users modal (doc step)",
      "optional": true,
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Once done click Close in All Other users modal (doc step)",
      "optional": true,
      "expected": {
        "within": "Modal",
        "labelEquals": "Close",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Once done click Close in All Other users modal (doc step)",
      "optional": true,
      "timeoutMs": 60000
    }
  ]
}
