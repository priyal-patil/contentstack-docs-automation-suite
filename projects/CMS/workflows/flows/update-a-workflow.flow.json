{
  "id": "update-a-workflow",
  "project": "CMS",
  "module": "workflows",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-workflows-and-publish-rules/update-a-workflow",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Workflows in settings left nav (doc step)",
      "expected": {
        "labelEquals": "Workflows",
        "labelMatch": "contains",
        "within": "Left Navigation"
      }
    },
    { "action": "click", "target": "Workflows in settings left nav (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Workflow page title (doc step)",
      "expected": {
        "labelEquals": "Workflow",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflows tab selected Workflow (doc step)",
      "expected": {
        "labelEquals": "Workflows",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow listing Name column header (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Workflow listing first workflow row link (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Workflow Name label (doc step)",
      "expected": {
        "labelEquals": "Workflow Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow Description label (doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow Scope label (doc step)",
      "expected": {
        "labelEquals": "Scope",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Workflow Stages section label (doc step)",
      "expected": {
        "labelEquals": "Workflow Stages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Workflow edit first stage Edit icon (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Prevent self-advancement label (doc step)",
      "optional": true,
      "expected": {
        "within": "Modal",
        "labelEquals": "Prevent self-advancement",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Workflow first stage Done button (doc step)",
      "optional": true,
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Workflow edit first stage Delete icon (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    {
      "action": "warn",
      "value": "Doc: API reference — update a workflow via API is separate from the UI steps above."
    },
    {
      "action": "verify",
      "target": "Workflow editor Save button label (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Workflow editor Save button (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Workflow save success toast (doc step)",
      "expected": {},
      "timeoutMs": 120000
    }
  ]
}
