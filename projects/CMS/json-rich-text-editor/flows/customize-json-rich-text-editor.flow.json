{
  "id": "customize-json-rich-text-editor",
  "project": "CMS",
  "module": "json-rich-text-editor",
  "source": "https://www.contentstack.com/docs/developers/json-rich-text-editor/customize-json-rich-text-editor",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    { "action": "click", "target": "Content Models (doc step)" },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "click",
      "target": "Create New (doc step)",
      "expected": { "modalTitle": "Create New Content Type" }
    },
    { "action": "enter", "target": "Name (doc step)", "value": "Shared JSON RTE Doc CT-{unique}" },
    { "action": "select", "target": "Type (doc step)", "value": "Single" },
    { "action": "click", "target": "Save and proceed (doc step)" },
    { "action": "click", "target": "Insert a field (doc step)" },
    { "action": "click", "target": "JSON Rich Text Editor field tile (doc step)" },
    {
      "action": "verify",
      "target": "JSON Rich Text Editor Properties heading (doc step)",
      "expected": {
        "within": "Main content",
        "labelEquals": "JSON Rich Text Editor Properties",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "JSON RTE Advanced tab (doc step)",
      "expected": { "labelEquals": "Advanced", "labelMatch": "contains" }
    },
    { "action": "click", "target": "JSON RTE Advanced tab (doc step)" },
    {
      "action": "verify",
      "target": "Editor Type Custom JSON RTE (doc step)",
      "expected": { "labelEquals": "Custom", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Editor Type Custom JSON RTE (doc step)" },
    {
      "action": "verify",
      "target": "JSON RTE Select All formatting options (doc step)",
      "expected": { "labelEquals": "Select All", "labelMatch": "contains" }
    },
    { "action": "click", "target": "JSON RTE Select All formatting options (doc step)" },
    {
      "action": "verify",
      "target": "JSON RTE Embed Objects label (doc step)",
      "expected": { "labelEquals": "Embed Object(s)", "labelMatch": "contains" }
    },
    { "action": "click", "target": "JSON RTE Embed Objects toggle (doc step)" },
    {
      "action": "click",
      "target": "JSON RTE Embed reference select Shared content type (doc step)"
    },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": { "labelEquals": "Save and Close", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Save and Close (doc step)" }
  ]
}
