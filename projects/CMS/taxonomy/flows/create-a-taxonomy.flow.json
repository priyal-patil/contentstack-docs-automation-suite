{
  "id": "create-a-taxonomy",
  "project": "CMS",
  "module": "taxonomy",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/taxonomy/create-a-taxonomy",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy in settings (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy in settings (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy page title (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "New Taxonomy button (doc step)",
      "expected": {
        "labelEquals": "New Taxonomy",
        "labelMatch": "equals"
      }
    },
    { "action": "click", "target": "New Taxonomy button (doc step)", "timeoutMs": 60000 },
    {
      "action": "click",
      "target": "Taxonomy New Taxonomy menu Create New (doc step)",
      "warnOnly": true,
      "alwaysWarn": true,
      "warnMessage": "The '+ New Taxonomy' button now opens a dropdown (Create New / Import) — the doc does not mention this step. Remove warnOnly when doc is updated.",
      "timeoutMs": 5000
    },
    {
      "action": "verify",
      "target": "Create New Taxonomy modal title (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Modal",
        "labelEquals": "Create New Taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Create Taxonomy Name field label (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Create Taxonomy UID field label (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Unique ID",
        "labelMatch": "contains"
      },
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Create Taxonomy Description field label (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Create Taxonomy UID instruction text (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "UID cannot be changed once saved",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Create Taxonomy Name input (doc step)",
      "value": "Doc taxonomy {unique}"
    },
    {
      "action": "enter",
      "target": "Create Taxonomy Description textarea (doc step)",
      "value": "Doc taxonomy description {unique}"
    },

    {
      "action": "verify",
      "target": "Create Taxonomy modal Create Taxonomy button (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Create Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Create Taxonomy modal Create Taxonomy button (doc step)", "timeoutMs": 90000 }
  ]
}
