{
  "id": "import-a-taxonomy",
  "project": "CMS",
  "module": "taxonomy",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/taxonomy/import-a-taxonomy",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy in settings (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy in settings (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy page title (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Create New Taxonomy split button (doc step)",
      "expected": {
        "labelEquals": "Create New Taxonomy",
        "labelMatch": "equals"
      }
    },
    { "action": "click", "target": "New Taxonomy button open dropdown (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy New Taxonomy menu Import (doc step)",
      "expected": {
        "labelEquals": "Import",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy New Taxonomy menu Import (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Import Taxonomy modal title (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Import Taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Import Taxonomy Choose a File label (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Choose a File",
        "labelMatch": "contains"
      }
    },
    {
      "action": "upload",
      "target": "Import Taxonomy file input (doc step)",
      "value": "./dummyData/taxonomy-import-template.json"
    },
    {
      "action": "verify",
      "target": "Import Taxonomy display at top label (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Display this taxonomy at the top of the list",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Import Taxonomy display at top checkbox (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Import Taxonomy modal Done button (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Done",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Import Taxonomy modal Done button (doc step)", "timeoutMs": 90000 }
  ]
}
