{
  "id": "export-a-taxonomy",
  "project": "CMS",
  "module": "taxonomy",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/taxonomy/export-a-taxonomy",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy in settings (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy in settings (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy page title (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Taxonomy listing first row Actions vertical ellipsis (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Taxonomy row vertical menu Export as JSON (doc step)",
      "expected": {
        "labelEquals": "Export as JSON",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Taxonomy row vertical menu Export as CSV (doc step)",
      "expected": {
        "labelEquals": "Export as CSV",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Taxonomy row vertical menu Export as JSON (doc step)",
      "timeoutMs": 60000
    }
  ]
}
