{
  "id": "delete-a-term",
  "project": "CMS",
  "module": "taxonomy",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/taxonomy/delete-a-term",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy in settings (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy in settings (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy page title (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy listing first taxonomy row open edit (doc step)", "timeoutMs": 60000 },
    { "action": "click", "target": "Taxonomy term list first term vertical actions menu (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Term vertical menu Delete Term (doc step)",
      "expected": {
        "labelEquals": "Delete Term",
        "labelMatch": "contains"
      }
    },
    { "action": "hover", "target": "Term vertical menu Delete Term (doc step)" },
    { "action": "click", "target": "Term vertical menu Delete Term (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Delete Term modal title (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Delete Term",
        "labelMatch": "contains"
      }
    },

    {
      "action": "enter",
      "target": "Delete Term type DELETE input (doc step)",
      "value": "DELETE"
    },
    {
      "action": "verify",
      "target": "Delete Term modal Delete button (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Delete Term modal Delete button (doc step)", "timeoutMs": 90000 }
  ]
}
