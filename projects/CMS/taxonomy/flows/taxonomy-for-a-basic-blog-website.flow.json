    },
    {
      "action": "verify",
      "target": "Create Taxonomy UID field label (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Unique ID",
        "labelMatch": "contains",
        "labelMismatchWarnOnly": true
