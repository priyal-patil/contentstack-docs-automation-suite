    { "action": "click", "target": "Create New (doc step)", "expected": { "modalTitle": "Create New Content Type" } },
    { "action": "enter", "target": "Name (doc step)", "value": "Blog Posts {unique5}" },
    { "action": "enter", "target": "UID (doc step)", "value": "blog_posts_{unique25}" },
    { "action": "click", "target": "Save and proceed" },
