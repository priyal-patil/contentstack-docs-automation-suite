      "action": "verify",
      "target": "Term details Create a Sibling Term button (doc step)",
      "expected": {
        "labelEquals": "Create a Child Term",
        "labelMatch": "contains",
        "labelMismatchWarnOnly": true
      }
    },
    { "action": "click", "target": "Create a Child Term button on taxonomy details (doc step)", "timeoutMs": 60000 },

    { "action": "enter", "target": "Create Term Term Name input (doc step)", "value": "Data Science {unique5}" },
    { "action": "click", "target": "Create Term modal Save button (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy terms outline left panel (doc step)",
      "expected": { "labelEquals": "Artificial Intelligence", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Content Models (doc step)", "timeoutMs": 60000 },
