    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy in settings (doc step)",
      "expected": { "within": "Left Navigation", "labelEquals": "Taxonomy", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Taxonomy in settings (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy page title (doc step)",
      "expected": { "labelEquals": "Taxonomy", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "New Taxonomy button (doc step)",
      "expected": { "labelEquals": "New Taxonomy", "labelMatch": "contains" }
    },
    { "action": "click", "target": "New Taxonomy button (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy New Taxonomy menu Create New (doc step)",
      "expected": { "labelEquals": "Create New", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Taxonomy New Taxonomy menu Create New (doc step)", "timeoutMs": 60000 },
