      "action": "verify",
      "target": "Add Term button on taxonomy details (doc step)",
      "expected": {
        "labelEquals": "Add Term",
        "labelMatch": "contains",
        "labelMismatchWarnOnly": true
      }
    },
    { "action": "click", "target": "Add Term button on taxonomy details (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Term Details section title (doc step)",
      "expected": { "labelEquals": "Term Details", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Create Term Term Name field label (doc step)",
      "expected": { "within": "Modal", "labelEquals": "Term Name", "labelMatch": "contains" }
