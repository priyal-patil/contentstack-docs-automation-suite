      "action": "verify",
      "target": "Content Type Builder (doc step)",
      "expected": { "labelEquals": "Title", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Insert a field (doc step)",
      "expected": { "documentedFields": ["Insert a field"], "visible": true }
    },
    { "action": "click", "target": "Insert a field" },
    {
      "action": "verify",
      "target": "Taxonomy field tile label (doc step)",
      "expected": { "labelEquals": "Taxonomy", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Taxonomy (doc step)" },
    { "action": "click", "target": "Builder area (dismiss properties)" },
    { "action": "click", "target": "Properties (Taxonomy field) (doc step)" },
    { "action": "enter", "target": "Taxonomy field Display Name input (doc step)", "value": "Categories" },
    {
      "action": "verify",
      "target": "+ Add Taxonomy (doc step)",
      "expected": { "labelEquals": "Add Taxonomy", "labelMatch": "contains" }
    },
    { "action": "click", "target": "+ Add Taxonomy (doc step)" },
    {
      "action": "verify",
      "target": "Select Taxonomy field label (doc step)",
      "expected": { "labelEquals": "Select Taxonomy", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Select Taxonomy dropdown (doc step)" },
    { "action": "click", "target": "Select first available taxonomy from dropdown (doc step)" },
    {
      "action": "verify",
      "target": "Apply in Add Taxonomy modal (doc step)",
      "expected": { "within": "Modal", "labelEquals": "Apply", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Apply taxonomy field properties (doc step)" },
    { "action": "click", "target": "Taxonomy field properties Advanced tab (doc step)", "timeoutMs": 15000, "optional": true },
    { "action": "click", "target": "Taxonomy field Optional field switch (doc step)", "timeoutMs": 15000, "optional": true },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": { "labelEquals": "Save and Close", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Save and Close (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": { "within": "Left Navigation", "labelEquals": "Entries", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 60000 },
    { "action": "click", "target": "New Entry (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "Blog Posts content type row in new entry modal (doc step)", "timeoutMs": 60000 },
    { "action": "click", "target": "Create Entry (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "Categories field Select Term(s) (doc step)", "timeoutMs": 60000 },
    { "action": "click", "target": "First term in term picker (doc step)", "timeoutMs": 60000 },
    { "action": "click", "target": "Apply term selection (doc step)", "timeoutMs": 60000 }
  ]
}
