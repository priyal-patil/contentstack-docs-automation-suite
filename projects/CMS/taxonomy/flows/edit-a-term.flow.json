{
  "id": "edit-a-term",
  "project": "CMS",
  "module": "taxonomy",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/taxonomy/edit-a-term",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Taxonomy in settings (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy in settings (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Taxonomy page title (doc step)",
      "expected": {
        "labelEquals": "Taxonomy",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Taxonomy listing first taxonomy row open edit (doc step)", "timeoutMs": 60000 },
    { "action": "click", "target": "Taxonomy terms list first term row select (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Term Details section title (doc step)",
      "expected": {
        "labelEquals": "Term Details",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Edit Term UID cannot be changed instruction (doc step)",
      "expected": {
        "labelEquals": "UID ",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Edit Term Term Name input (doc step)",
      "value": "Doc term edited {unique}"
    },
    {
      "action": "verify",
      "target": "Edit Term Save button (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains",
        "labelMismatchWarnOnly": true
      }
    },
    { "action": "click", "target": "Edit Term Save button (doc step)", "timeoutMs": 90000 }
  ]
}
