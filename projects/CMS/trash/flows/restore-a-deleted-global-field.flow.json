{
  "id": "restore-a-deleted-global-field",
  "project": "CMS",
  "module": "trash",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/manage-trash/restore-a-deleted-global-field",
  "type": "executable",
  "use": ["login", "selectStack"],
  "preflight": {
    "runFlowWhenTrashGlobalFieldsEmpty": "delete-a-global-field"
  },
  "steps": [
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Trash in settings left nav (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Trash",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash in settings left nav (doc step)" },
    {
      "action": "verify",
      "target": "Trash Global Fields tab (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash Global Fields tab (doc step)" },
    { "action": "verify", "target": "Trash date range filter DATE (doc step)" },
    {
      "action": "click",
      "target": "Trash date range filter DATE click (doc step)",
      "timeoutMs": 30000,
      "optional": true
    },
    {
      "action": "verify",
      "target": "Trash Filters section header (doc step)",
      "expected": {
        "within": "Trash filters panel",
        "withinStrict": false,
        "labelEquals": "Filters",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Trash Deleted By filter section (doc step)",
      "expected": {
        "within": "Trash filters panel",
        "withinStrict": false,
        "labelEquals": "Deleted By",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash Deleted By filter checkbox (doc step)" },
    {
      "action": "verify",
      "target": "Trash Reset filters button (doc step)",
      "expected": {
        "within": "Trash filters panel",
        "withinStrict": false,
        "labelEquals": "Reset filters",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash Reset filters button (doc step)" },
    { "action": "hover", "target": "Trash global field row to restore hover (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Trash global field row Restore action visible after hover (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Restore",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash global field row Restore action after hover (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Restore global field modal title (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Restore Global Field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Restore global field modal primary Restore button visible (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Restore",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Restore global field modal Restore button (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Deleted global field builder from trash restore (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Main content",
        "withinStrict": false,
        "labelEquals": "Global field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Global field builder Insert a field (trash restore doc step)",
      "timeoutMs": 60000,
      "expected": {
        "labelEquals": "Insert a field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Insert a field (trash restore doc step)",
      "timeoutMs": 30000,
      "optional": true
    },
    {
      "action": "verify",
      "target": "Restore on deleted global field builder (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Top Bar",
        "withinStrict": false,
        "labelEquals": "Restore",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Restore on deleted global field builder click (doc step)", "timeoutMs": 60000 }
  ]
}
