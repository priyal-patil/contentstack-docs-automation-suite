{
  "id": "about-trash",
  "project": "CMS",
  "module": "trash",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/manage-trash/about-trash",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
      
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Trash in settings left nav (doc step)",
      "expected": {
        "labelEquals": "Trash",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash in settings left nav (doc step)" },
    {
      "action": "verify",
      "target": "Trash Entries tab (doc step)",
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Trash Assets tab (doc step)",
      "expected": {
        "labelEquals": "Assets",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Trash Content Types tab (doc step)",
      "expected": {
        "labelEquals": "Content Types",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Trash Global Fields tab (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash Content Types tab (doc step)" },
    { "action": "click", "target": "Trash Global Fields tab (doc step)" },
    { "action": "click", "target": "Trash Assets tab (doc step)" },
    { "action": "click", "target": "Trash Entries tab (doc step)" }
  ]
