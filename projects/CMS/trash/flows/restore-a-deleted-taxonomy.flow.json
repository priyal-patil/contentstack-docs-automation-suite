        "labelEquals": "Restore",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Restore taxonomy split open restore options dropdown (doc step)", "timeoutMs": 30000 },
    {
      "action": "verify",
      "target": "Restore taxonomy With Content Type Association menu option (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Restore with Content Type Association",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Restore taxonomy Without Content Type Association menu option (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Restore without Content Type Association",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Restore taxonomy With Content Type Association (doc step)", "timeoutMs": 60000 }
