        "labelEquals": "Deleted By",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Trash Deleted By filter checkbox (doc step)" },
    {
      "action": "verify",
      "target": "Trash Reset filters button (doc step)",
      "expected": {
        "within": "Trash filters panel",
