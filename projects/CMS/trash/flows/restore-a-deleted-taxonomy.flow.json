    { "action": "click", "target": "Trash taxonomy Restore in vertical action menu (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Restore taxonomy modal title (doc step)",
      "timeoutMs": 60000,
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Restore Taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Restore taxonomy modal description (doc step)",
      "timeoutMs": 30000,
      "optional": true,
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "taxonomy",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Restore taxonomy split Restore primary button (doc step)",
      "timeoutMs": 30000,
      "expected": {
        "within": "Modal",
