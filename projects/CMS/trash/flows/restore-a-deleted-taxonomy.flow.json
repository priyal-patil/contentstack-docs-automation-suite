    { "action": "click", "target": "Trash in settings left nav (doc step)" },
    {
      "action": "verify",
      "target": "Trash Taxonomies tab (doc step)",
      "expected": {
        "labelEquals": "Taxonomies",
        "labelMatch": "contains"
      }
