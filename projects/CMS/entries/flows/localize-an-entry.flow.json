{
  "id": "localize-an-entry",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/multilingual-content/localize-an-entry",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Entry row (doc step)"
    },
    {
      "action": "click",
      "target": "Language dropdown (doc step)"
    },
    {
      "action": "click",
      "target": "Second language option (doc step)"
    },
    {
      "action": "enter",
      "target": "Entry Title (doc step)",
      "value": "Localized Entry {unique}"
    },
    {
      "action": "verify",
      "target": "Save (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save (doc step)"
    }
  ]
}

