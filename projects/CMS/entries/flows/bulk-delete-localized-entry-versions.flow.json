{
  "id": "bulk-delete-localized-entry-versions",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/bulk-delete-localized-entry-versions",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "click", "target": "Ensure Master Locale Selected (doc step)" },
    { "action": "click", "target": "See more (entry editor) (doc step)" },
    {
      "action": "verify",
      "target": "Delete from see more label (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Delete from see more (doc step)" },
    {
      "action": "verify",
      "target": "Delete Entry modal (doc step)",
      "expected": {
        "labelEquals": "Delete Entry",
        "labelMatch": "contains",
        "modalTitle": "Delete Entry"
      }
    },
    {
      "action": "verify",
      "target": "Select all languages in delete modal (doc step)",
      "expected": {
        "labelEquals": "Select all languages",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Select all languages in delete modal (doc step)" },
    {
      "action": "verify",
      "target": "Delete confirm label (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Delete confirm (doc step)" }
  ]
}
