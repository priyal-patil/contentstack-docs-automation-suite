{
  "id": "json-rte-comments",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/json-rich-text-editor/json-rte-comments",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Content Models (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "+ New Content Type (doc step)"
    },
    {
      "action": "click",
      "target": "Create New (doc step)"
    },
    {
      "action": "enter",
      "target": "Name (doc step)",
      "value": "JSON RTE CT-{unique5}"
    },
    {
      "action": "enter",
      "target": "Description (ct create) (doc step)",
      "value": "CT for JSON RTE comments"
    },
    {
      "action": "click",
      "target": "Single (Type) (doc step)"
    },
    {
      "action": "click",
      "target": "Save and proceed (doc step)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "JSON Rich Text Editor field (doc step)"
    },
    {
      "action": "click",
      "target": "Save and Close (doc step)"
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "New Entry (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "JSON RTE CT row (doc step)"
    },
    {
      "action": "click",
      "target": "Create Entry (doc step)"
    },
    {
      "action": "enter",
      "target": "Entry Title (doc step)",
      "value": "JSON RTE Entry {unique5}"
    },
    {
      "action": "enter",
      "target": "JSON RTE editor (doc step)",
      "value": "First dummy paragraph for JSON RTE comments.\n\nSecond dummy paragraph for JSON RTE comments."
    },
    {
      "action": "click",
      "target": "Save (doc step)"
    },
    {
      "action": "click",
      "target": "First paragraph add comment icon (doc step)"
    },
    {
      "action": "enter",
      "target": "JSON RTE comment textbox (doc step)",
      "value": "Dummy comment on first paragraph"
    },
    {
      "action": "click",
      "target": "Post JSON RTE comment (doc step)"
    },
    {
      "action": "click",
      "target": "Cancel JSON RTE comment (doc step)"
    },
    {
      "action": "click",
      "target": "Add comment on selected text (doc step)"
    },
    {
      "action": "enter",
      "target": "JSON RTE comment textbox (doc step)",
      "value": "Dummy comment on selected text"
    },
    {
      "action": "click",
      "target": "Post JSON RTE comment (doc step)"
    },
    {
      "action": "click",
      "target": "Asset toolbar dropdown (doc step)"
    },
    {
      "action": "click",
      "target": "Upload new asset(s) (doc step)"
    },
    {
      "action": "click",
      "target": "Choose Files (asset modal) (doc step)"
    },
    {
      "action": "upload",
      "target": "Asset file input (doc step)",
      "value": "./dummyData/sample.svg"
    },
    {
      "action": "click",
      "target": "Last block add comment icon (doc step)"
    },
    {
      "action": "enter",
      "target": "JSON RTE comment textbox (doc step)",
      "value": "Dummy comment on image block"
    },
    {
      "action": "click",
      "target": "Post JSON RTE comment (doc step)"
    }
  ]
}
