{
  "id": "remove-entry-version-names",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/remove-entry-version-names",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "click", "target": "Save (doc step)" },
    {
      "action": "verify",
      "target": "Version icon (doc step)",
      "expected": {
        "visible": true
      }
    },
    { "action": "click", "target": "Version icon (doc step)" },
    { "action": "verify", "target": "Version History", "expected": { "labelEquals": "Version History", "labelMatch": "contains" } },
    { "action": "click", "target": "Second version timeline row (doc step)" },
    { "action": "click", "target": "Second version rename icon (doc step)" },
    { "action": "enter", "target": "Version name input (doc step)", "value": "" }
  ]
}
