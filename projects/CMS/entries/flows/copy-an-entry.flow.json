{
  "id": "copy-an-entry",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/copy-an-entry",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Entry row (doc step)"
    },
    {
      "action": "click",
      "target": "See more (entry editor) (doc step)"
    },
    {
      "action": "click",
      "target": "Copy from see more (doc step)"
    },
    {
      "action": "verify",
      "target": "Copy Entry modal (doc step)",
      "expected": {
        "modalTitle": "Copy Entry"
      }
    },
    {
      "action": "click",
      "target": "Current Locale Only (doc step)"
    },
    {
      "action": "verify",
      "target": "Current Locale Only (doc step)",
      "expected": {
        "labelEquals": "Current Locale Only",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "All Locales (doc step)",
      "expected": {
        "labelEquals": "All Locales",
        "labelMatch": "contains"
      }
    }
  ]
}

