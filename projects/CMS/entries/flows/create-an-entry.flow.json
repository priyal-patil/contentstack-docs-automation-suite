{
  "id": "create-an-entry",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/create-an-entry",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries page (doc step)",
      "expected": {
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "+ New Entry (doc step)",
      "expected": {
        "labelEquals": "New Entry",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "+ New Entry (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Content Type row (doc step)",
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Proceed (doc step)",
      "warnOnly": true,
      "alwaysWarn": true,
      "warnMessage": "Proceed button is not mentioned in the document — update the doc and remove alwaysWarn/warnOnly when ready.",
      "expected": {
        "labelEquals": "Proceed",
        "labelMatch": "contains"
      },
      "timeoutMs": 30000
    },
    {
      "action": "click",
      "target": "Proceed (doc step)",
      "warnOnly": true,
      "alwaysWarn": true,
      "warnMessage": "Proceed button is not mentioned in the document — update the doc and remove alwaysWarn/warnOnly when ready.",
      "timeoutMs": 30000
    },
    {
      "action": "enter",
      "target": "Entry Title (doc step)",
      "value": "Auto Entry {unique}"
    },
    {
      "action": "verify",
      "target": "Save (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      },
      "timeoutMs": 60000
    },
    {
      "action": "click",
      "target": "Save (doc step)",
      "timeoutMs": 30000
    }
  ]
}
