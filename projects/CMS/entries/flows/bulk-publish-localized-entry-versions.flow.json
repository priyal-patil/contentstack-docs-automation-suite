    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "click", "target": "Ensure Master Locale Selected (doc step)" },
    {
      "action": "verify",
      "target": "Publish (bottom-right) (doc step)",
      "expected": {
        "labelEquals": "Publish",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Publish (bottom-right) (doc step)" },
    {
      "action": "verify",
      "target": "Publish queue page indicator (doc step)",
      "expected": {
        "labelEquals": "Publish Queue",
        "labelMatch": "contains"
      }
