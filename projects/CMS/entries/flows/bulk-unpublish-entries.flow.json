{
  "id": "bulk-unpublish-entries",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/bulk-unpublish-entries",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First entry checkbox (doc step)" },
    { "action": "click", "target": "Second entry checkbox (doc step)" },
    { "action": "click", "target": "Floating panel See More (doc step)" },
    {
      "action": "verify",
      "target": "Unpublish floating button label (doc step)",
      "expected": {
        "labelEquals": "Unpublish",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Unpublish in floating panel (doc step)" },
    {
      "action": "verify",
      "target": "Unpublish Entries modal title (doc step)",
      "expected": {
        "labelEquals": "Unpublish Entries",
        "labelMatch": "contains",
        "modalTitle": "Unpublish Entries"
      }
    },
    {
      "action": "verify",
      "target": "Select Environment(s) label (doc step)",
      "expected": {
        "labelEquals": "Select Environment(s)",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Select Language(s) label (doc step)",
      "expected": {
        "labelEquals": "Select Language(s)",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Unpublish label (doc step)",
      "expected": {
        "labelEquals": "Unpublish",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Send label (doc step)",
      "expected": {
        "labelEquals": "Send",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "First Environment checkbox (doc step)" },
    { "action": "click", "target": "Send (doc step)" }
  ]
}

