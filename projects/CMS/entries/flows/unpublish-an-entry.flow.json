{
  "id": "unpublish-an-entry",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/unpublish-an-entry",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Entry row (doc step)"
    },
    {
      "action": "click",
      "target": "Unpublish (bottom-right) (doc step)"
    },
    {
      "action": "verify",
      "target": "Unpublish Entry modal (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "modalTitle": "Unpublish Entry"
      }
    },
    {
      "action": "click",
      "target": "First Unpublish Environment option (doc step)"
    },
    {
      "action": "click",
      "target": "First Unpublish Language option (doc step)"
    },
    {
      "action": "click",
      "target": "Now (unpublish) (doc step)"
    },
    {
      "action": "click",
      "target": "Unpublish confirm/send (doc step)"
    }
  ]
}

