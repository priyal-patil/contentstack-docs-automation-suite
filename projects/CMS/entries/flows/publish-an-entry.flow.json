{
  "id": "publish-an-entry",
  "project": "CMS",
  "module": "entries",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/publish-an-entry",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Entries (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First Entry row (doc step)"
    },
    {
      "action": "verify",
      "target": "Publish (bottom-right) (doc step)",
      "expected": {
        "labelEquals": "Publish",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Publish (bottom-right) (doc step)"
    },
    {
      "action": "verify",
      "target": "Publish Entry modal (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "modalTitle": "Publish Entry"
      }
    },
    {
      "action": "click",
      "target": "First Environment option (doc step)"
    },
    {
      "action": "click",
      "target": "First Language option (doc step)"
    },
    {
      "action": "click",
      "target": "Variants dropdown (if available) (doc step)"
    },
    {
      "action": "click",
      "target": "Now (doc step)"
    },
    {
      "action": "verify",
      "target": "Send (doc step)",
      "expected": {
        "labelEquals": "Send",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Send (doc step)"
    },
    {
      "action": "verify",
      "target": "Publish Review or Publish References modal (doc step)"
    }
  ]
}

