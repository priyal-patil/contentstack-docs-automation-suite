{
  "id": "multi-factor-authentication",
  "project": "CMS",
  "module": "security",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/security/multi-factor-authentication",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "verify",
      "target": "User Profile icon (doc step)",
      "expected": {
        "within": "Top Bar",
        "withinStrict": true
      }
    },
    { "action": "click", "target": "User Profile icon (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Profile Settings option label (doc step)",
      "expected": {
        "labelEquals": "Profile Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Profile Settings option (doc step)" },
    {
      "action": "verify",
      "target": "Security tab label (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Security",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Security tab in profile left nav (doc step)" },
    {
      "action": "verify",
      "target": "Multi-Factor Authentication section label (doc step)",
      "expected": {
        "labelEquals": "Multi-Factor Authentication",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "MFA Add or Enable button (doc step)"
    },
    { "action": "click", "target": "MFA Enable button (doc step)" },
    {
      "action": "verify",
      "target": "Set Up MFA modal title (doc step)",
      "expected": {
        "modalTitle": "Set Up Multi-Factor Authentication",
        "labelEquals": "Set Up Multi-Factor Authentication",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Continue button on modal (doc step)",
      "expected": {
        "labelEquals": "Continue",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Set Up MFA modal Continue button (doc step)" },
    {
      "action": "verify",
      "target": "Authenticator App modal title (doc step)",
      "expected": {
        "labelEquals": "Authenticator App (Android, iPhone, Desktop)",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Authenticator App modal Next button (doc step)",
      "expected": {
        "labelEquals": "Next",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Authenticator App modal Next button (doc step)" },
    {
      "action": "verify",
      "target": "Authenticator App modal title (doc step)",
      "expected": {
        "labelEquals": "Authenticator App (Android, iPhone, Desktop)",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Authenticator App modal Verify button (doc step)",
      "expected": {
        "labelEquals": "Verify",
        "labelMatch": "contains",
        "warnOnly": true
      }
    }
  ]
}
