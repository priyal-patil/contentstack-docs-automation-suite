{
  "id": "change-personal-details",
  "project": "CMS",
  "module": "security",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/security/change-personal-details",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "User Profile icon (doc step)",
      "expected": {
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "User Profile icon (doc step)" },
    {
      "action": "verify",
      "target": "Profile option in dropdown (doc step)",
      "expected": {
        "labelEquals": "Profile",
        "labelMatch": "contains"
      }
    },
    {
      "action": "warn",
      "target": "Profile option in dropdown (doc step)",
      "value": "Doc/UI mismatch: The documentation refers to this option as \"Profile\" but the UI displays it as \"Profile Settings\"."
    },
    { "action": "click", "target": "Profile option in dropdown (doc step)" },

    {
      "action": "verify",
      "target": "Profile section (doc step)",
      "expected": {
        "labelEquals": "First Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Last Name (doc step)",
      "expected": {
        "labelEquals": "Last Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Company Name (doc step)",
      "expected": {
        "labelEquals": "Company Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Company Name input (doc step)",
      "value": "Test Company",
      "clearFirst": true
    },
        {
      "action": "verify",
      "target": "Profile Image (doc step)"
    },
    {
      "action": "verify",
      "target": "Save button in profile (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Save button in profile (doc step)" }
  ]
}
