{
  "id": "session-management",
  "project": "CMS",
  "module": "security",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/security/session-management",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "verify",
      "target": "User Profile icon (doc step)",
      "expected": {
        "within": "Top Bar",
        "withinStrict": true
      }
    },
    { "action": "click", "target": "User Profile icon (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Profile Settings option label (doc step)",
      "expected": {
        "labelEquals": "Profile Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Profile Settings option (doc step)" },
    {
      "action": "verify",
      "target": "Security tab label (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Security",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Security tab in profile left nav (doc step)" },
    {
      "action": "verify",
      "target": "Session Management section label (doc step)",
      "expected": {
        "labelEquals": "Session Management",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Terminate Other Sessions button (doc step)" }
  ]
}
