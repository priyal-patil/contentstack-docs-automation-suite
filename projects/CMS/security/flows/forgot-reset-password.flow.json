{
  "id": "forgot-reset-password",
  "project": "CMS",
  "module": "security",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/security/forgot-reset-password",
  "type": "executable",
  "use": ["openLogin"],
  "steps": [
    {
      "action": "verify",
      "target": "Login page title (doc step)",
      "expected": {
        "labelEquals": "Log in to Contentstack",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Forgot Password link in login page (doc step)",
      "expected": {
        "labelEquals": "Forgot Password?",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Forgot Password link in login page (doc step)" },
    {
      "action": "verify",
      "target": "Forgot Password page title (doc step)",
      "expected": {
        "labelEquals": "Forgot your password?",
        "labelMatch": "contains"
      }
    },
    { "action": "verify", "target": "Forgot Password page subtext (doc step)" },
    {
      "action": "verify",
      "target": "Forgot Password Email label (doc step)",
      "expected": {
        "labelEquals": "Email",
        "labelMatch": "contains"
      }
    },
    { "action": "enter", "target": "Forgot Password Email input (doc step)", "value": "priyal.p@contentstack.com" },
    {
      "action": "verify",
      "target": "Send Instructions button (doc step)",
      "expected": {
        "labelEquals": "Send Instructions",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Send Instructions button (doc step)" },
    {
      "action": "warn",
      "target": "Open reset email and link (doc step)",
      "value": "External step: Open the email from Contentstack and use the password reset link provided. The link directs you to the password reset form."
    },
    {
      "action": "warn",
      "target": "Reset password form submission (doc step)",
      "value": "External step: In the Reset Password form, enter your new password. Confirm it by re-entering the same password in the second field. Click Reset Password to complete the update."
    }
  ]
}
