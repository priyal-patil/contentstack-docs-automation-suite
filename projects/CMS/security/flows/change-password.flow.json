{
  "id": "change-password",
  "project": "CMS",
  "module": "security",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/security/change-password",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "verify", "target": "User Profile icon (doc step)" },
    { "action": "click", "target": "User Profile icon (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Profile Settings option label (doc step)",
      "expected": {
        "labelEquals": "Profile Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "warn",
      "target": "Profile Settings option label (doc step)",
      "value": "Doc/UI mismatch: The documentation refers to this option as \"Profile\" but the UI displays it as \"Profile Settings\"."
    },
    { "action": "click", "target": "Profile Settings option (doc step)" },
    {
      "action": "verify",
      "target": "Security tab label (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Security",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Security tab in profile left nav (doc step)" },
    {
      "action": "verify",
      "target": "Email and Password section label (doc step)",
      "expected": {
        "labelEquals": "Email & Password",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Reset Password button (doc step)" },
    {
      "action": "verify",
      "target": "Reset Password modal title (doc step)",
      "expected": {
        "modalTitle": "Reset Password",
        "labelEquals": "Reset Password",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Old Password label (doc step)",
      "expected": {
        "labelEquals": "Old Password",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "New Password label (doc step)",
      "expected": {
        "labelEquals": "New Password",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Confirm Password label (doc step)",
      "expected": {
        "labelEquals": "Confirm Password",
        "labelMatch": "contains"
      }
    },
    { "action": "enter", "target": "Old Password input (doc step)", "value": "987654321" },
    { "action": "enter", "target": "New Password input (doc step)", "value": "123456789" },
    { "action": "enter", "target": "Confirm Password input (doc step)", "value": "123456789" },
    {
      "action": "verify",
      "target": "Update password button in reset modal (doc step)",
      "expected": {
        "labelEquals": "Update",
        "labelMatch": "contains"
      }
    }
  ]
}
