    { "action": "click", "target": "Users nav in Administration (doc step)" },
    {
      "action": "verify",
      "target": "Vertical ellipsis in Action column (doc step)",
      "expected": {
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Vertical ellipsis in Action column (doc step)" },
    {
      "action": "verify",
      "target": "Unlock User option (doc step)",
      "expected": {
