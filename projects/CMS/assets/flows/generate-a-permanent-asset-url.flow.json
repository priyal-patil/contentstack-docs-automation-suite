{
  "id": "generate-a-permanent-asset-url",
  "project": "CMS",
  "module": "assets",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/generate-a-permanent-asset-url",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Assets (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Assets",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Assets (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "First folder row (doc step)",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "First Asset row (doc step)"
    },
    {
      "action": "verify",
      "target": "Permanent URL label (doc step)",
      "expected": {
        "labelEquals": "Permanent URL",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Generate permanent URL (doc step)",
      "expected": {
        "labelEquals": "Generate permanent URL",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Generate permanent URL (doc step)"
    },
    {
      "action": "enter",
      "target": "Permanent URL slug input (doc step)",
      "value": "asset-slug-{unique5}"
    },
    {
      "action": "click",
      "target": "Save (doc step)"
    }
  ]
}