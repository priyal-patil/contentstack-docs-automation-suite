{
  "id": "move-assets-to-folder-in-bulk",
  "project": "CMS",
  "module": "assets",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/move-assets-to-folder-in-bulk",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Assets (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Assets",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Assets (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First asset checkbox (doc step)" },
    { "action": "click", "target": "Second asset checkbox (doc step)" },
    {
      "action": "verify",
      "target": "Move To floating button label (doc step)",
      "expected": {
        "labelEquals": "Move To",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Move To in floating panel (doc step)" },
    {
      "action": "verify",
      "target": "Move To modal title (doc step)",
      "expected": {
        "labelEquals": "Move To",
        "labelMatch": "contains",
        "modalTitle": "Move To"
      }
    },
    {
      "action": "verify",
      "target": "New Folder label in Move To modal (doc step)",
      "expected": {
        "labelEquals": "New Folder",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "New Folder in Move To modal (doc step)" },
    { "action": "enter", "target": "Move To new folder name input (doc step)", "value": "BulkMoveFolder-{unique}" },
    {
      "action": "verify",
      "target": "Move here button label (doc step)",
      "expected": {
        "labelEquals": "Move here",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Move here (doc step)" }
  ]
}

