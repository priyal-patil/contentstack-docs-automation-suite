{
  "id": "delete-a-folder",
  "project": "CMS",
  "module": "assets",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/delete-a-folder/",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Assets (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Assets",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Assets (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First folder vertical ellipses (doc step)" },
    {
      "action": "verify",
      "target": "Delete option label (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Delete option (doc step)" },
    {
      "action": "verify",
      "target": "Delete Asset Folder modal title (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains",
        "modalTitle": "Delete"
      }
    },
    { "action": "click", "target": "Delete confirm (doc step)" }
  ]
}

