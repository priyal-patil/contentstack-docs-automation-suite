{
  "id": "blog-listing-page",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/content-modeling/blog-listing-page",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "Blog Listing Page card (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Blog Listing Page card (doc step)" },
    {
      "action": "verify",
      "target": "Schema tab (doc step)",
      "expected": { "labelMatch": "Schema" }
    },
    { "action": "click", "target": "Schema tab (doc step)" },
    {
      "action": "verify",
      "target": "Blog Listing Page schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["URL"],
          ["Search"],
          ["Search", "Placeholder Text"],
          ["Search", "Search Button"],
          ["Page Components"],
          ["Page Components", "Hero Banner"],
          ["Page Components", "Hero Banner", "Hero Banner"],
          ["Page Components", "From Blog"],
          ["Page Components", "From Blog", "Title H2"],
          ["Page Components", "From Blog", "Featured Blogs"],
          ["View Articles"],
          ["Widget"],
          ["Widget", "Title H2"],
          ["Widget", "Type"],
          ["Widget", "Related Blogs"],
          ["SEO"],
          ["SEO", "Meta Title"],
          ["SEO", "Meta Description"],
          ["SEO", "Meta Keywords"],
          ["SEO", "Enable Search Indexing"]
        ],
        "exactMatch": true
      }
    }
  ]
}
