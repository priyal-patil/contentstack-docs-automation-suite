{
  "id": "product-listing-page",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/content-modeling/product-listing-page",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "Product Listing Page card (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Product Listing Page card (doc step)" },
    {
      "action": "verify",
      "target": "Schema tab (doc step)",
      "expected": { "labelMatch": "Schema" }
    },
    { "action": "click", "target": "Schema tab (doc step)" },
    {
      "action": "verify",
      "target": "Product Listing Page schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["URL"],
          ["Page Components"],
          ["Page Components", "Hero Banner"],
          ["Page Components", "Hero Banner", "Hero Banner"],
          ["Page Components", "Product"],
          ["Page Components", "Product", "Product"],
          ["Page Components", "Widget"],
          ["Page Components", "Widget", "Title H2"],
          ["Page Components", "Widget", "Related Products"],
          ["SEO"],
          ["SEO", "Meta Title"],
          ["SEO", "Meta Description"],
          ["SEO", "Meta Keywords"],
          ["SEO", "Enable Search Indexing"]
        ],
        "exactMatch": true
      }
    },
    {
      "action": "click",
      "target": "Preview Schema dropdown (doc step)"
    },
    {
      "action": "click",
      "target": "Product option in dropdown (doc step)"
    },
    {
      "action": "verify",
      "target": "Product schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["URL"],
          ["Description"],
          ["Featured Image"],
          ["Price"],
          ["Call To Action"]
        ],
        "exactMatch": true
      }
    }
  ]
}
