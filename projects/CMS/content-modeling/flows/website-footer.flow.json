{
  "id": "website-footer",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/content-modeling/website-footer",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "Website Footer card (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Website Footer card (doc step)" },
    {
      "action": "verify",
      "target": "Schema tab (doc step)",
      "expected": { "labelMatch": "Schema" }
    },
    { "action": "click", "target": "Schema tab (doc step)" },
    {
      "action": "verify",
      "target": "Website Footer schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["Logo"],
          ["Navigation"],
          ["Navigation", "Link"],
          ["Navigation", "Open in new tab"],
          ["Social Media"],
          ["Social Media", "Social Share"],
          ["Social Media", "Social Share", "Title"],
          ["Social Media", "Social Share", "Icon"],
          ["Social Media", "Social Share", "Url"],
          ["Copyright"]
        ],
        "exactMatch": true
      }
    }
  ]
}
