        "exactMatch": true
      }
    },
    {
      "action": "click",
      "target": "Preview Schema dropdown (doc step)"
    },
    {
      "action": "click",
      "target": "Our Team option in dropdown (doc step)"
    },
    {
      "action": "verify",
      "target": "Our Team schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["Description"],
          ["Employees"],
          ["Employees", "Name"],
          ["Employees", "Designation"],
