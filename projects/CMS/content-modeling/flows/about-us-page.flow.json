          ["Page Components", "Awards & Achievements", "Awards & Achievements", "Link"],
          ["Page Components", "Sections"],
          ["Page Components", "Sections", "Title H2"],
          ["Page Components", "Sections", "Description"],
          ["Page Components", "Sections", "Call to Action"],
          ["Page Components", "Sections", "Image"],
          ["Page Components", "Sections", "Is Image Right Aligned"],
          ["Page Components", "Team"],
          ["Page Components", "Team", "Team"],
          ["Page Components", "Contact Us"],
          ["Page Components", "Contact Us", "Contact"],
          ["SEO"],
          ["SEO", "Meta Title"],
          ["SEO", "Meta Description"],
          ["SEO", "Meta Keywords"],
          ["SEO", "Enable Search Indexing"]
