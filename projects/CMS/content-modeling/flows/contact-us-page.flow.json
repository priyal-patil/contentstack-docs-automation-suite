{
  "id": "contact-us-page",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/content-modeling/contact-us-page",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "Contact Us Page card (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Contact Us Page card (doc step)" },
    {
      "action": "verify",
      "target": "Schema tab (doc step)",
      "expected": { "labelMatch": "Schema" }
    },
    { "action": "click", "target": "Schema tab (doc step)" },
    {
      "action": "verify",
      "target": "Contact Us Page schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["Primary Contact Details"],
          ["Page Components"],
          ["Page Components", "Other Location"],
          ["Page Components", "Other Location", "Other Locations"],
          ["Page Components", "Other Location", "Other Locations", "City/Country"],
          ["Page Components", "Other Location", "Other Locations", "Address"],
          ["Page Components", "Other Location", "Other Locations", "Location Image"],
          ["Page Components", "Other Location", "Other Locations", "Maps Location"],
          ["Page Components", "Section with HTML Code"],
          ["Page Components", "Section with HTML Code", "Title"],
          ["Page Components", "Section with HTML Code", "Description"],
          ["Page Components", "Section with HTML Code", "HTML Code"],
          ["Page Components", "Section with HTML Code", "Is HTML Code Left Aligned?"],
          ["Page Components", "Contact Us Form"],
          ["Page Components", "Contact Us Form", "Contact Fields"],
          ["Page Components", "Contact Us Form", "Contact Fields", "Title"],
          ["Page Components", "Contact Us Form", "Contact Fields", "Placeholder Text"],
          ["Page Components", "Contact Us Form", "Short Detailed Message"],
          ["Page Components", "Contact Us Form", "Submit"],
          ["SEO"],
          ["SEO", "Meta Title"],
          ["SEO", "Meta Description"],
          ["SEO", "Meta Keywords"],
          ["SEO", "Enable Search Indexing"]
        ],
        "exactMatch": true
      }
    },
    {
      "action": "click",
      "target": "Preview Schema dropdown (doc step)"
    },
    {
      "action": "click",
      "target": "Contact option in dropdown (doc step)"
    },
    {
      "action": "verify",
      "target": "Contact schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["Address"],
          ["Contact Number"],
          ["Email Address"]
        ],
        "exactMatch": true
      }
    }
  ]
}
