{
  "id": "website-header",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/content-modeling/website-header",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "Website Header card (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Website Header card (doc step)" },
    {
      "action": "verify",
      "target": "Schema tab (doc step)",
      "expected": { "labelMatch": "Schema" }
    },
    { "action": "click", "target": "Schema tab (doc step)" },
    {
      "action": "verify",
      "target": "Website Header schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["Logo"],
          ["Navigation Menu"],
          ["Navigation Menu", "Label"],
          ["Navigation Menu", "Call To Action"],
          ["Navigation Menu", "Open in New Tab"],
          ["Notification Bar"],
          ["Notification Bar", "Announcement Text"],
          ["Notification Bar", "Show Announcement?"]
        ],
        "exactMatch": true
      }
    }
  ]
}
