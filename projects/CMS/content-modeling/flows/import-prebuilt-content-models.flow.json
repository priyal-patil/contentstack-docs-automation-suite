{
  "id": "import-prebuilt-content-models",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-content-types/import-prebuilt-content-models",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "within": "Left Navigation", "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "About Us Page (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Hover on About Us Page card (doc step)" },
    {
      "action": "verify",
      "target": "Import (doc step)",
      "expected": { "within": "Modal", "labelMatch": "Import" }
    },
    { "action": "click", "target": "Import (doc step)" },
    { "action": "click", "target": "Authorize (doc step)", "optional": true },
    {
      "action": "verify",
      "target": "Stack Name (doc step)",
      "expected": {},
      "timeoutMs": 25000
    },
    {
      "action": "verify",
      "target": "Import Content Model to Stack (doc step)",
      "expected": {}
    },
    {
      "action": "verify",
      "target": "Import Content Model (doc step)",
      "expected": { "labelMatch": "Import Content Model" }
    },
    { "action": "click", "target": "Import Content Model (doc step)" },
    {
      "action": "verify",
      "target": "View Content Models (doc step)",
      "expected": { "labelMatch": "View Content Models" },
      "timeoutMs": 120000
    },
    { "action": "click", "target": "View Content Models (doc step)" }
  ]
}
