{
  "id": "blog-landing-page",
  "project": "CMS",
  "module": "content-modeling",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/content-modeling/blog-landing-page",
  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": { "labelMatch": "Content Model" }
    },
    { "action": "click", "target": "Content Models (doc step)" },
    {
      "action": "verify",
      "target": "+ New Content Type (doc step)",
      "expected": { "labelMatch": "New" }
    },
    { "action": "click", "target": "+ New Content Type (doc step)" },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": { "labelMatch": "Use Prebuilt" }
    },
    { "action": "click", "target": "Use Prebuilt (doc step)" },
    {
      "action": "verify",
      "target": "Add Content Model (doc step)",
      "expected": { "within": "Modal", "modalTitle": "Add Content Model" }
    },
    {
      "action": "verify",
      "target": "Blog Landing Page card (doc step)",
      "expected": { "within": "Modal" }
    },
    { "action": "click", "target": "Blog Landing Page card (doc step)" },
    {
      "action": "verify",
      "target": "Schema tab (doc step)",
      "expected": { "labelMatch": "Schema" }
    },
    { "action": "click", "target": "Schema tab (doc step)" },
    {
      "action": "verify",
      "target": "Blog Landing Page schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Title"],
          ["URL"],
          ["Author"],
          ["Date"],
          ["Featured Image"],
          ["Body"],
          ["Related Post"],
          ["Is Archived?"],
          ["Comments"],
          ["Comments", "Leave A Reply"],
          ["Comments", "Call To Action"],
          ["Social Share"],
          ["Social Share", "Social Media Share"],
          ["Social Share", "Social Media Share", "Title"],
          ["Social Share", "Social Media Share", "Icon"],
          ["Social Share", "Social Media Share", "Url"],
          ["SEO"],
          ["SEO", "Meta Title"],
          ["SEO", "Meta Description"],
          ["SEO", "Meta Keywords"],
          ["SEO", "Enable Search Indexing"]
        ],
        "exactMatch": true
      }
    },
    {
      "action": "click",
      "target": "Preview Schema dropdown (doc step)"
    },
    {
      "action": "click",
      "target": "Author option in dropdown (doc step)"
    },
    {
      "action": "verify",
      "target": "Author schema fields (doc step)",
      "expected": {
        "documentedStructure": [
          ["Full Name"],
          ["Picture"],
          ["Bio"]
        ],
        "exactMatch": true
      }
    }
  ]
}
