{
  "id": "view-stack-details",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/view-stack-details",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "verify",
      "target": "Name (edit stack doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Description (edit stack doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Stack Owner Email (doc step)"
    },
    {
      "action": "verify",
      "target": "Appearance section (doc step)",
      "expected": {
        "labelEquals": "Appearance",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Stack Color (settings doc step)",
      "expected": {
        "labelEquals": "Stack Color",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "API Credentials section (doc step)",
      "expected": {
        "labelEquals": "API Credentials",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "API Key (doc step)"
    }
  ]
}
