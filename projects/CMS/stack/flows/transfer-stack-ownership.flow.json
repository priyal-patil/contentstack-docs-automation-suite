{
  "id": "transfer-stack-ownership",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/transfer-stack-ownership",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "verify",
      "target": "Transfer Ownership (doc step)",
      "expected": {
        "labelEquals": "Transfer Ownership",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Transfer Ownership (doc step)"
    },
    {
      "action": "verify",
      "target": "Recipient Email (doc step)",
      "expected": {
        "labelEquals": "email",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Recipient Email (doc step)",
      "value": "owner+{unique}@example.com"
    },
    {
      "action": "verify",
      "target": "Transfer Ownership (confirm doc step)",
      "expected": {
        "labelEquals": "Transfer Ownership",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Transfer Ownership (confirm doc step)"
    }
  ]
}
