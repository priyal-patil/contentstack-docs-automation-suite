{
  "id": "import-prebuilt-stack",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/import-prebuilt-stack",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Stacks (doc step)"
    },
    {
      "action": "verify",
      "target": "+ New Stack (doc step)",
      "expected": {
        "within": "Top Bar",
        "withinStrict": false,
        "labelEquals": "New Stack",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "+ New Stack (doc step)"
    },
    {
      "action": "verify",
      "target": "Use Prebuilt (doc step)",
      "expected": {
        "labelEquals": "Use Prebuilt",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Use Prebuilt (doc step)"
    },
    {
      "action": "verify",
      "target": "Add Stack modal (doc step)",
      "expected": {
        "labelEquals": "Add Stack",
        "labelMatch": "contains"
    
      }
    },
    {
      "action": "hover",
      "target": "First prebuilt stack card (doc step)"
    },
    {
      "action": "verify",
      "target": "Import button on prebuilt stack card (doc step)",
      "expected": {
        "labelEquals": "Import",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Import button on prebuilt stack card (doc step)"
    },
    {
      "action": "click",
      "target": "Read More until Authorize visible (doc step)",
      "optional": true
    },
    {
      "action": "enter",
      "target": "Stack Name (import doc step)",
      "value": "Auto Imported Stack {unique5}"
    },
    {
      "action": "verify",
      "target": "Import Sample (doc step)",
      "warnOnly": true,
      "expected": {
        "labelEquals": "Import Sample",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Import Sample (doc step)",
      "optional": true
    }
  ]
}
