{
  "id": "import-prebuilt-stack",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/import-prebuilt-stack",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "verify",
      "target": "Headless CMS",
      "expected": {
        "labelEquals": "Headless CMS",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "navigate",
      "target": "https://app.contentstack.com/#!/stacks"
    },
    {
      "action": "click",
      "target": "+ New Stack (doc step)"
    },
    {
      "action": "click",
      "target": "Use Prebuilt (doc step)"
    },
    {
      "action": "click",
      "target": "Import (doc step)"
    },
    {
      "action": "enter",
      "target": "Stack Name (import doc step)",
      "value": "Auto Imported Stack {unique}"
    },
    {
      "action": "click",
      "target": "Import Sample (doc step)"
    }
  ]
}
