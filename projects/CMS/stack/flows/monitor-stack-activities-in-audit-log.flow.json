{
  "id": "monitor-stack-activities-in-audit-log",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/monitor-stack-activities-in-audit-log",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)"
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "click",
      "target": "Audit Log tab (doc step)"
    },
    {
      "action": "verify",
      "target": "Audit Date column (doc step)",
      "expected": {
        "labelEquals": "Date",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Audit Action column (doc step)",
      "expected": {
        "labelEquals": "Action",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Audit Title column (doc step)",
      "expected": {
        "labelEquals": "Title",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Audit Remote Address column (doc step)",
      "expected": {
        "labelEquals": "Remote Address",
        "labelMatch": "contains"
      }
    }
  ]
}
