{
  "id": "leave-a-stack",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/leave-a-stack",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "verify",
      "target": "Leave Stack (doc step)",
      "warnOnly": true,
      "expected": {
        "labelEquals": "Leave Stack",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Leave Stack (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Leave Stack (confirm doc step)",
      "optional": true,
      "expected": {
        "labelEquals": "Leave Stack",
        "labelMatch": "contains"
      }
    }
  ]
}
