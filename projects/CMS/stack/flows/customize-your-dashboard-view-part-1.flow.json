{
  "id": "customize-your-dashboard-view-part-1",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/customize-your-dashboard-view",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "verify",
      "target": "Dashboard page (doc step)",
      "expected": {
        "labelEquals": "Dashboard",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "+ Dashboard Extension (doc step)",
      "expected": {
        "within": "Top Bar",
        "withinStrict": false,
        "labelEquals": "Dashboard Extension",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "+ Dashboard Extension (doc step)"
    },

    {
      "action": "verify",
      "target": "Add Widgets modal (doc step)",
      "expected": {
        "labelEquals": "Add Widgets",
        "labelMatch": "contains"
      }
    },
    {
      "action": "hover",
      "target": "First widget card in Add Widgets modal (doc step)"
    },
    {
      "action": "verify",
      "target": "+ Add To Dashboard button (doc step)",
      "expected": {
        "labelEquals": "Add To Dashboard",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "+ Add To Dashboard button (doc step)"
    },
    {
      "action": "verify",
      "target": "+ New Dashboard Extension (doc step)",
      "expected": {
        "labelEquals": "New Dashboard Extension",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Close Add Widgets modal (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Dashboard icon (doc step)",
      "expected": {
        "labelEquals": "Edit Dashboard",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Edit Dashboard icon (doc step)"
    },
    {
      "action": "verify",
      "target": "Done button (doc step)",
      "expected": {
        "labelEquals": "Done",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Done button (doc step)"
    }
  ]
}
