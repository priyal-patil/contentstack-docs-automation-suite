{
  "id": "delete-a-stack",
  "project": "CMS",
  "module": "stack",
  "stage": "delete",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/delete-a-stack",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "verify",
      "target": "Delete Stack (doc step)",
      "expected": {
        "labelEquals": "Delete Stack",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delete Stack (doc step)"
    },
    {
      "action": "verify",
      "target": "Delete confirmation (doc step)",
      "expected": {
        "labelEquals": "DELETE",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Delete confirmation (doc step)",
      "value": "DELETE"
    },
    {
      "action": "verify",
      "target": "Delete (confirm doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delete (confirm doc step)"
    }
  ]
}
