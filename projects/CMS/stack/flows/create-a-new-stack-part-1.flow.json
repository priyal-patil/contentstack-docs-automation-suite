{
  "id": "create-a-new-stack-part-1",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/create-a-new-stack",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "verify",
      "target": "Headless CMS",
      "expected": {
        "labelEquals": "Headless CMS",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "navigate",
      "target": "https://app.contentstack.com/#!/stacks"
    },
    {
      "action": "verify",
      "target": "+ New Stack (doc step)",
      "expected": {
        "labelEquals": "New Stack",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "+ New Stack (doc step)"
    },
    {
      "action": "click",
      "target": "Create New (doc step)"
    },
    {
      "action": "verify",
      "target": "Name (create stack doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Name (create stack doc step)",
      "value": "Auto Stack {unique}"
    },
    {
      "action": "enter",
      "target": "Description (create stack doc step)",
      "value": "Auto stack description {unique}"
    },
    {
      "action": "click",
      "target": "Create (doc step)"
    }
  ]
}
