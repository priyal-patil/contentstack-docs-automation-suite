{
  "id": "create-a-new-stack-part-1",
  "project": "CMS",
  "module": "stack",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-stack/create-a-new-stack",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Stack (doc step)",
      "expected": {
        "within": "Top right corner",
        "withinStrict": false,
        "labelEquals": "+ New Stack",
        "labelMatch": "contains"
      },
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "+ New Stack (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Create New (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Create New",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Create New (doc step)",
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Create New Stack modal heading (doc step)",
      "timeoutMs": 30000,
      "expected": {
        "labelEquals": "Create New Stack",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Name label in Create New Stack modal (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Description label in Create New Stack modal (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Set Master Language label (create stack doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Set Master Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Stack Color (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Stack Color",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Name (create stack doc step)",
      "value": "Auto Stack {unique}"
    },
    {
      "action": "enter",
      "target": "Description (create stack doc step)",
      "value": "Auto stack description {unique}"
    },
    {
      "action": "click",
      "target": "Stack Color swatch (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "verify",
      "target": "Create (doc step)",
      "timeoutMs": 15000,
      "expected": {
        "labelEquals": "Create",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Create (doc step)",
      "timeoutMs": 60000
    }
  ]
}
