  "type": "executable",
  "use": ["login", "selectStack"],
  "steps": [
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": { "labelEquals": "Entries", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Entries (doc step)" },
    {
      "action": "enter",
      "target": "Search bar input (doc step)",
      "value": "Auto"
    },
    { "action": "click", "target": "Search submit button (doc step)" },
    {
      "action": "verify",
      "target": "Search results displayed (doc step)",
      "expected": {}
    },
    { "action": "click", "target": "First entry checkbox (doc step)" },
    { "action": "click", "target": "Floating panel See More (doc step)", "warnOnly": true },
    {
      "action": "verify",
      "target": "Delete in floating panel (doc step)",
      "expected": { "labelEquals": "Delete", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Delete in floating panel (doc step)" },
    {
      "action": "verify",
      "target": "Delete Entries modal (doc step)",
      "expected": { "labelMatch": "Delete Entr", "modalTitle": "Delete Entr" }
    },
    { "action": "click", "target": "Delete confirm (doc step)" }
  ]
}
