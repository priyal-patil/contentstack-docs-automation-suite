{
  "id": "edit-a-webhook",
  "project": "CMS",
  "module": "webhook",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-webhooks/edit-a-webhook",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Webhooks in settings left nav (doc step)",
      "expected": {
        "withinStrict": true,
        "labelEquals": "Webhooks",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Webhooks in settings left nav (doc step)"
    },
    {
      "action": "verify",
      "target": "First webhook row (doc step)",
      "expected": {
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "First webhook row (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Webhook tab (doc step)",
      "expected": {
        "labelEquals": "Edit Webhook",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Name label (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "URL to Notify label (doc step)",
      "expected": {
        "labelEquals": "URL",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save webhook button (doc step)"
    }
  ]
}
