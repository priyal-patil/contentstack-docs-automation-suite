{
  "id": "view-webhook-logs",
  "project": "CMS",
  "module": "webhook",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-webhooks/view-webhook-logs",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Webhooks (doc step)",
      "expected": {
        "labelEquals": "Webhooks",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Webhooks (doc step)"
    },
    {
      "action": "click",
      "target": "First webhook row (doc step)",
      "timeoutMs": 60000
    },
    {
      "action": "verify",
      "target": "Log tab (doc step)",
      "expected": {
        "labelEquals": "Log",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Log tab (doc step)"
    },
    {
      "action": "verify",
      "target": "First log row (doc step)"
    },
    {
      "action": "verify",
      "target": "Time column header (doc step)",
      "expected": {
        "labelEquals": "Time",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Action column header (doc step)",
      "expected": {
        "labelEquals": "Action",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Module column header (doc step)",
      "expected": {
        "labelEquals": "Module",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Title column header (doc step)",
      "expected": {
        "labelEquals": "Title",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Call Status column header (doc step)",
      "expected": {
        "labelEquals": "Call Status",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Actions column header (doc step)",
      "expected": {
        "labelEquals": "Actions",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Vertical ellipsis in log Actions column (doc step)"
    },
    {
      "action": "click",
      "target": "Vertical ellipsis in log Actions column (doc step)"
    },
    {
      "action": "verify",
      "target": "See Details option (doc step)",
      "expected": {
        "labelEquals": "See Details",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "See Details option (doc step)"
    }
  ]
