    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Webhooks (doc step)",
      "expected": {
        "labelEquals": "Webhooks",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Webhooks (doc step)" },
    { "action": "click", "target": "First webhook row (doc step)", "timeoutMs": 60000 },
    {
      "action": "verify",
      "target": "Log tab (doc step)",
      "expected": {
        "labelEquals": "Log",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Log tab (doc step)" },
    {
      "action": "verify",
      "target": "Webhook log columns (doc step)"
    }
  ]
