{
  "id": "edit-a-global-field",
  "project": "CMS",
  "module": "global-field",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/global-field/edit-a-global-field",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Content Models",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Content Models (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Global Fields (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "vertical ellipsis" },
  
    
    {
      "action": "verify",
      "target": "Edit option (Global Field action) (doc step)",
      "expected": {
        "labelEquals": "Edit",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Edit option (Global Field action) (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Global Field modal (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Edit Global Field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Name (edit global field) (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "UID (edit global field) (doc step)",
      "expected": {
        "labelEquals": "UID",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Description (edit global field) (doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Name (edit global field) (doc step)",
      "value": "APPEND:-updated-{unique}"
    },
    {
      "action": "enter",
      "target": "Description (edit global field) (doc step)",
      "value": "APPEND: updated-{unique}"
    },
    {
      "action": "click",
      "target": "Update (edit global field) (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    }
  ]
}
