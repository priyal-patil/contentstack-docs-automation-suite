        "withinStrict": false,
        "labelEquals": "Content Models",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Content Models (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Global Fields (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "vertical ellipsis", "expected": { "rowContains": "Address-" } },
  
    
    {
      "action": "verify",
      "target": "Edit option (Global Field action) (doc step)",
      "expected": {
        "labelEquals": "Edit",
        "labelMatch": "contains"
      }
    },
    {
