{
  "id": "delete-a-global-field",
  "project": "CMS",
  "module": "global-field",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/global-field/delete-a-global-field",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Content Models",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Content Models (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields (doc step)",
      "expected": {
        "within": "Left panel",
        "withinStrict": false,
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Global Fields (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "vertical ellipsis"
    },
    {
      "action": "verify",
      "target": "Delete option (Global Field action) (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delete option (Global Field action) (doc step)"
    },
    {
      "action": "verify",
      "target": "Delete Global Field modal (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Delete Global Field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Global Field name confirm input (doc step)",
      "value": "AUTO_FROM_MODAL"
    },
    {
      "action": "verify",
      "target": "Delete (global field modal) (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delete (global field modal) (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    }
  ]
}
