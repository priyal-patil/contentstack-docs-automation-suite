{
  "id": "create-a-global-field-part-2",
  "project": "CMS",
  "module": "global-field",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/global-field/create-a-global-field",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Content Models",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Content Models (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Global Fields (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Any Global Field title (doc step)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "verify",
      "target": "Global (doc step)",
      "expected": {
        "within": "Field picker",
        "withinStrict": false,
        "labelEquals": "Global",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Global (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Properties title (doc step)",
      "expected": {
        "labelEquals": "Global Properties",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Select Global Field (doc step)",
      "expected": {
        "labelEquals": "Select Global Field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Select Global Field (doc step)"
    },
    {
      "action": "verify",
      "target": "Any Global Field row (doc step)",
      "expected": {
        "modalTitle": "Select Global Fields"
      }
    },
    {
      "action": "click",
      "target": "Any Global Field row (doc step)"
    },
    {
      "action": "verify",
      "target": "Proceed (Select Global Fields) (doc step)",
      "expected": {
        "labelEquals": "Proceed",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Proceed (Select Global Fields) (doc step)"
    },
    {
      "action": "verify",
      "target": "Save (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save (doc step)"
    }
  ]
}
