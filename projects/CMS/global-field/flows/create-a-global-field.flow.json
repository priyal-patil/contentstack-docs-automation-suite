{
  "id": "create-a-global-field",
  "project": "CMS",
  "module": "global-field",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/global-field/create-a-global-field",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Content Models (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Content Models",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Content Models (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Global Fields (doc step)"
    },
    {
      "action": "verify",
      "target": "Global Fields page (doc step)",
      "expected": {
        "labelEquals": "Global Fields",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "+ New Global Field (doc step)",
      "expected": {
        "labelEquals": "New Global Field",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "+ New Global Field (doc step)"
    },
    {
      "action": "verify",
      "target": "Create New Global Field modal (doc step)",
      "expected": {
        "modalTitle": "Create New Global Field"
      }
    },
    {
      "action": "verify",
      "target": "Global Field Name (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Global Field Name (doc step)",
      "value": "Address-{unique5}"
    },
    {
      "action": "verify",
      "target": "Description (doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Description (doc step)",
      "value": "Address global field"
    },
    {
      "action": "verify",
      "target": "Proceed (doc step)",
      "expected": {
        "labelEquals": "Proceed",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Proceed (doc step)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "verify",
      "target": "Display Name (doc step)",
      "expected": {
        "labelEquals": "Display Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "House Number"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "verify",
      "target": "Display Name (doc step)",
      "expected": {
        "labelEquals": "Display Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Apartment Name"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "verify",
      "target": "Display Name (doc step)",
      "expected": {
        "labelEquals": "Display Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Street Name"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Single Line Textbox (doc step)"
    },
    {
      "action": "verify",
      "target": "Display Name (doc step)",
      "expected": {
        "labelEquals": "Display Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "City"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "click",
      "target": "Insert a field"
    },
    {
      "action": "click",
      "target": "Number (doc step)"
    },
    {
      "action": "verify",
      "target": "Display Name (doc step)",
      "expected": {
        "labelEquals": "Display Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Display Name (doc step)",
      "value": "Postal Code"
    },
    {
      "action": "click",
      "target": "Builder area (dismiss properties)"
    },
    {
      "action": "verify",
      "target": "Save and Close (doc step)",
      "expected": {
        "labelEquals": "Save and Close",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save and Close (doc step)"
    }
  ]
}
