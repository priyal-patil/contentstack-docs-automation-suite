{
  "id": "delete-a-release",
  "project": "CMS",
  "module": "releases",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/create-and-manage-releases/delete-a-release",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Releases (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Releases",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Releases (doc step)", "timeoutMs": 90000 },
    { "action": "verify", "target": "Releases list (doc step)" },
    { "action": "click", "target": "Hover release row for delete icon (doc step)" },
    { "action": "click", "target": "Delete release icon (doc step)" },
    {
      "action": "verify",
      "target": "Delete Release modal title (doc step)",
      "expected": {
        "modalTitle": "Delete Release",
        "labelEquals": "Delete Release",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Delete button in delete release modal (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Delete button in delete release modal (doc step)" }
  ]
}
