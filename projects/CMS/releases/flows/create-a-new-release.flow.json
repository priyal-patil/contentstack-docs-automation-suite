{
  "id": "create-a-new-release",
  "project": "CMS",
  "module": "releases",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/create-and-manage-releases/create-a-new-release",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Releases (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Releases",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Releases (doc step)", "timeoutMs": 90000 },
    { "action": "verify", "target": "Releases list (doc step)" },
    { "action": "click", "target": "New Release button (doc step)" },
    {
      "action": "verify",
      "target": "Create a New Release modal title (doc step)",
      "expected": {
        "modalTitle": "Create a New Release",
        "labelEquals": "Create a New Release",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Release Name label (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Release Description label (doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    { "action": "enter", "target": "Release Name input (doc step)", "value": "{unique25}" },
    { "action": "enter", "target": "Release Description input (doc step)", "value": "Created by automation {unique}" },
    { "action": "click", "target": "Create button in release modal (doc step)" },
    { "action": "verify", "target": "Releases list (doc step)" }
  ]
}
