{
  "id": "add-entry-asset-to-a-release",
  "project": "CMS",
  "module": "releases",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/create-and-manage-releases/add-entry-asset-to-a-release",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "click", "target": "See more (entry editor) (doc step)" },
    { "action": "click", "target": "Add to Release from see more (doc step)" },
    {
      "action": "verify",
      "target": "Add to Release modal title (doc step)",
      "expected": {
        "modalTitle": "Add to Release",
        "labelEquals": "Add to Release",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Select release dropdown in Add to Release modal (doc step)",
      "timeoutMs": 15000
    },
    { "action": "click", "target": "First release row in Add to Release modal (doc step)", "timeoutMs": 30000 },
    {
      "action": "click",
      "target": "Select Release confirmation in release picker modal (doc step)",
      "timeoutMs": 20000
    },
    {
      "action": "verify",
      "target": "Select Language(s) label in Add to Release modal (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Select Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Publish action in Add to Release modal (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Publish",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Unpublish action in Add to Release modal (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Unpublish",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Add button in Add to Release modal (doc step)",
      "expected": {
        "within": "Modal",
        "labelEquals": "Add",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Add button in Add to Release modal (doc step)", "timeoutMs": 45000 },
    {
      "action": "verify",
      "target": "Add With References button (doc step)",
      "expected": { "labelEquals": "Add With References", "labelMatch": "contains" },
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Add Without References button (doc step)",
      "expected": { "labelEquals": "Add Without References", "labelMatch": "contains" },
      "warnOnly": true
    },
    { "action": "click", "target": "Add With References button (doc step)", "warnOnly": true }
  ]
}
