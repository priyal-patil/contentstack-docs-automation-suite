{
  "id": "add-a-custom-language",
  "project": "CMS",
  "module": "language",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/multilingual-content/add-a-custom-language",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 30000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "verify",
      "target": "Languages (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Languages (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "verify",
      "target": "Languages page (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "New Language (doc step)",
      "timeoutMs": 8000,
      "warnOnly": true,
      "alwaysWarn": true,
      "warnMessage": "Doc calls the button '+ New Language' but the UI text node is 'New Language' (the + is a CSS icon, not text) — update the doc.",
      "expected": {
        "labelEquals": "New Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "New Language (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "verify",
      "target": "Add Language modal (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Add Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Add Supported Language option (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Add Supported Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Create Custom Language option (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Create Custom Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Create Custom Language option (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "verify",
      "target": "Language Name label (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Language Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Language Name (doc step)",
      "timeoutMs": 10000,
      "value": "English - United Kingdom"
    },
    {
      "action": "verify",
      "target": "Language Code label (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Language Code",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Language Code (doc step)",
      "timeoutMs": 10000,
      "value": "en-gb"
    },
    {
      "action": "verify",
      "target": "Select Fallback Language label (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Select Fallback Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Select Fallback Language dropdown (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "enter",
      "target": "Select Fallback Language dropdown (doc step)",
      "timeoutMs": 10000,
      "value": "United States"
    },
    {
      "action": "click",
      "target": "English - United States option (doc step)",
      "timeoutMs": 10000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Add Language submit (doc step)",
      "timeoutMs": 8000,
      "expected": {
        "labelEquals": "Add",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Add Language submit (doc step)",
      "timeoutMs": 15000,
      "warnOnly": true
    }
  ]
}
