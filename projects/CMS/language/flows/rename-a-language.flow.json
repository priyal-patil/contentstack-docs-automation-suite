{
  "id": "rename-a-language",
  "project": "CMS",
  "module": "language",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/multilingual-content/rename-a-language",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)"
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "click",
      "target": "Languages (doc step)"
    },
    {
      "action": "verify",
      "target": "Languages page (doc step)",
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Any non-default language (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Language modal (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Edit Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Language Name (edit label doc step)",
      "expected": {
        "labelEquals": "Language Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Language Name (edit doc step)",
      "value": "APPEND: new"
    },
    {
      "action": "verify",
      "target": "Save Language (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save Language (doc step)"
    }
  ]
}
