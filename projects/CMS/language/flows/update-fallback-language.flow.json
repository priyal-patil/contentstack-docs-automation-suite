{
  "id": "update-fallback-language",
  "project": "CMS",
  "module": "language",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/multilingual-content/update-fallback-language",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "click",
      "target": "Languages (doc step)"
    },
    {
      "action": "verify",
      "target": "Languages page (doc step)",
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Second language from list (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Language modal (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Edit Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Select Fallback Language (edit label doc step)",
      "expected": {
        "labelEquals": "Select Fallback Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Select Fallback Language dropdown (doc step)"
    },
    {
      "action": "enter",
      "target": "Select Fallback Language dropdown (doc step)",
      "value": "English - United States"
    },
    {
      "action": "click",
      "target": "English - United States option (doc step)"
    },
    {
      "action": "verify",
      "target": "Save Language (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save Language (doc step)"
    }
  ]
}
