{
  "id": "delete-a-language",
  "project": "CMS",
  "module": "language",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/multilingual-content/delete-a-language",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "click",
      "target": "More (doc step)"
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "click",
      "target": "Languages (doc step)"
    },
    {
      "action": "verify",
      "target": "Languages page (doc step)",
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Language row action menu (doc step)"
    },
    {
      "action": "verify",
      "target": "Delete action (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delete action (doc step)"
    },
    {
      "action": "verify",
      "target": "Remove (doc step)",
      "expected": {
        "labelEquals": "Remove",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Remove (doc step)"
    }
  ]
}
