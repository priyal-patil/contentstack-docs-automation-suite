{
  "id": "add-a-language",
  "project": "CMS",
  "module": "language",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/multilingual-content/add-a-language",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS"
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)"
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": false,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)"
    },
    {
      "action": "verify",
      "target": "Languages (doc step)",
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Languages (doc step)"
    },
    {
      "action": "verify",
      "target": "Languages page (doc step)",
      "expected": {
        "labelEquals": "Languages",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "New Language (doc step)",
      "expected": {
        "labelEquals": "New Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "New Language (doc step)"
    },
    {
      "action": "verify",
      "target": "Add Language modal (doc step)",
      "expected": {
        "within": "Modal",
        "withinStrict": false,
        "labelEquals": "Add Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Add Supported Language option (doc step)",
      "expected": {
        "labelEquals": "Add Supported Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Create Custom Language option (doc step)",
      "expected": {
        "labelEquals": "Create Custom Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Add Supported Language option (doc step)"
    },
    {
      "action": "verify",
      "target": "Select Language label (doc step)",
      "expected": {
        "labelEquals": "Select Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Select Language dropdown (doc step)"
    },
    {
      "action": "enter",
      "target": "Select Language dropdown (doc step)",
      "value": "French"
    },
    {
      "action": "click",
      "target": "First language option (doc step)",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Select Fallback Language label (doc step)",
      "expected": {
        "labelEquals": "Select Fallback Language",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Select Fallback Language dropdown (doc step)"
    },
    {
      "action": "enter",
      "target": "Select Fallback Language dropdown (doc step)",
      "value": "English - United States"
    },
    {
      "action": "click",
      "target": "English - United States option (doc step)",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Add Language submit (doc step)",
      "expected": {
        "labelEquals": "Add",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Add Language submit (doc step)",
      "warnOnly": true
    }
  ]
}
