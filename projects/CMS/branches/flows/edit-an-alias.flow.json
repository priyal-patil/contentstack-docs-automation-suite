{
  "id": "edit-an-alias",
  "project": "CMS",
  "module": "branches",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/branches/edit-an-alias",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Branches in settings left nav (doc step)"
    },
    {
      "action": "verify",
      "target": "Aliases tab (doc step)",
      "expected": {
        "labelEquals": "Aliases",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Aliases tab (doc step)"
    },
    {
      "action": "click",
      "target": "Hover over alias row (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "target": "Edit icon on alias row (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Alias modal (doc step)",
      "expected": {
        "modalTitle": "Edit Alias"
      }
    },
    {
      "action": "verify",
      "target": "Alias ID label in Edit modal (doc step)",
      "expected": {
        "labelEquals": "Alias ID",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Target Branch label in Edit modal (doc step)",
      "expected": {
        "labelEquals": "Target Branch",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Target Branch dropdown in Edit Alias (doc step)"
    },
    {
      "action": "click",
      "target": "main option in target branch dropdown (doc step)"
    },
    {
      "action": "verify",
      "target": "Save button in Edit Alias modal (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Save button in Edit Alias modal (doc step)"
    }
  ]
}
