{
  "id": "delete-a-branch",
  "project": "CMS",
  "module": "branches",
  "stage": "delete",
  "source": "https://www.contentstack.com/docs/developers/branches/delete-a-branch",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Branches in settings left nav (doc step)"
    },
    {
      "action": "verify",
      "target": "Branches page header (doc step)",
      "expected": {
        "labelEquals": "Branches",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Actions menu on branch row (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "verify",
      "target": "Delete option in branch actions menu (doc step)",
      "warnOnly": true,
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    }
  ]
}
