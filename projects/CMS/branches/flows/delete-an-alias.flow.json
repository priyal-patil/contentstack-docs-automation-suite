{
  "id": "delete-an-alias",
  "project": "CMS",
  "module": "branches",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/branches/delete-an-alias",
  "type": "executable",
  "use": [
    "login",
    "selectStack"
  ],
  "steps": [
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Branches in settings left nav (doc step)"
    },
    {
      "action": "verify",
      "target": "Aliases tab (doc step)",
      "expected": {
        "labelEquals": "Aliases",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Aliases tab (doc step)"
    },
    {
      "action": "click",
      "target": "More Options icon on alias row (doc step)",
      "timeoutMs": 15000
    },
    {
      "action": "click",
      "target": "Delete Alias option in menu (doc step)"
    },
    {
      "action": "verify",
      "target": "Delete Alias modal (doc step)",
      "expected": {
        "modalTitle": "Delete Alias"
      }
    },
    {
      "action": "enter",
      "target": "Alias ID input in Delete modal (doc step)",
      "value": "automation_test_alias"
    },
    {
      "action": "verify",
      "target": "Delete button in Delete Alias modal (doc step)",
      "expected": {
        "labelEquals": "Delete",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delete button in Delete Alias modal (doc step)"
    }
  ]
}
