{
  "id": "preview-content-across-varied-window-sizes",
  "project": "CMS",
  "module": "live-preview",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/preview-content-across-varied-window-sizes",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "verify", "target": "Live Preview icon (doc step)" },
    { "action": "click", "target": "Live Preview icon (doc step)" },
    { "action": "verify", "target": "Live Preview window (doc step)", "timeoutMs": 60000 },
    { "action": "verify", "target": "Preview panel resize edge (doc step)" },
    { "action": "dragBy", "target": "Preview panel resize edge (doc step)", "value": "-150,0" },
    {
      "action": "verify",
      "target": "Open in new tab icon (doc step)",
      "optional": true,
      "alwaysWarn": true,
      "warnMessage": "Open in new tab icon (live-preview-browser-new-tab-btn) not visible — button only renders when LP has a configured preview URL"
    },
    { "action": "click", "target": "Open in new tab icon (doc step)", "optional": true },
    {
      "action": "click",
      "target": "Viewport toggle button (doc step)",
      "timeoutMs": 15000,
      "optional": true,
      "alwaysWarn": true,
      "warnMessage": "Doc names this 'Toggle Viewport' but target is mapped as 'Viewport toggle button' — name mismatch; also button only renders when LP has a configured preview URL"
    },
    {
      "action": "verify",
      "target": "Toggle orientation button (doc step)",
      "optional": true,
      "alwaysWarn": true,
      "warnMessage": "Toggle orientation button not displayed — click 'Toggle Viewport' button first to reveal the orientation toggle",
      "expected": {
        "labelEquals": "Orientation",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Toggle orientation (doc step)", "optional": true }
  ]
}
