{
  "id": "preview-content-across-multiple-channels",
  "project": "CMS",
  "module": "live-preview",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/preview-content-across-multiple-channels",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "verify", "target": "Live Preview icon (doc step)" },
    { "action": "click", "target": "Live Preview icon (doc step)" },
    { "action": "verify", "target": "Live Preview (doc step)" },
    {
      "action": "click",
      "target": "Select Environment dropdown in Live Preview initial modal (doc step)",
      "timeoutMs": 12000,
      "optional": true
    },
    {
      "action": "click",
      "target": "First environment option in Live Preview initial modal (doc step)",
      "timeoutMs": 12000,
      "optional": true
    },
    {
      "action": "click",
      "target": "Show Live Preview button (doc step)",
      "timeoutMs": 90000,
      "optional": true
    },
    {
      "action": "click",
      "target": "Viewport toggle button (doc step)",
      "timeoutMs": 15000,
      "optional": true,
      "alwaysWarn": true,
      "warnMessage": "Doc names this 'Toggle Viewport' but target is mapped as 'Viewport toggle button' — name mismatch; also button only renders when LP has a configured preview URL"
    },
    {
      "action": "verify",
      "target": "Toggle orientation button (doc step)",
      "optional": true,
      "alwaysWarn": true,
      "warnMessage": "Toggle orientation button not displayed — click 'Toggle Viewport' button first to reveal the orientation toggle",
      "expected": {
        "labelEquals": "Toggle Orientation",
        "labelMatch": "contains"
      }
    }
  ]
}
