{
  "id": "preview-content-across-multiple-channels",
  "project": "CMS",
  "module": "live-preview",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/content-managers/author-content/preview-content-across-multiple-channels",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Entries (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Entries",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Entries (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "First Entry row (doc step)" },
    { "action": "verify", "target": "Live Preview icon (doc step)" },
    { "action": "click", "target": "Live Preview icon (doc step)" },
    { "action": "verify", "target": "Live Preview window (doc step)" },
    {
      "action": "verify",
      "target": "Toggle orientation button (doc step)",
      "expected": {
        "labelEquals": "Orientation",
        "labelMatch": "contains"
      }
    },
    { "action": "verify", "target": "Horizontal viewport input (doc step)" },
    { "action": "verify", "target": "Vertical viewport input (doc step)" },
    { "action": "click", "target": "Toggle orientation (doc step)" },
    { "action": "enter", "target": "Horizontal viewport input (doc step)", "value": "500" },
    { "action": "enter", "target": "Vertical viewport input (doc step)", "value": "650" },
    {
      "action": "verify",
      "target": "Horizontal viewport value (doc step)",
      "expected": {
        "labelEquals": "500",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Vertical viewport value (doc step)",
      "expected": {
        "labelEquals": "650",
        "labelMatch": "contains"
      }
    }
  ]
}
