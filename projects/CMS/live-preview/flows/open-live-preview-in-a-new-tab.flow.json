{
  "id": "open-live-preview-in-a-new-tab",
  "project": "CMS",
  "module": "live-preview",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/set-up-live-preview/open-live-preview-in-a-new-tab",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Visual Experience from left nav (doc step)",
      "expected": {
        "labelEquals": "Visual Experience",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Visual Experience from left nav (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Visual Experience page title (doc step)",
      "expected": {
        "labelEquals": "Visual Experience",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Visual Experience General tab (doc step)", "timeoutMs": 30000 },
    {
      "action": "verify",
      "target": "Always Open in New Tab toggle label (doc step)",
      "expected": {
        "labelEquals": "Always Open in New Tab",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Always Open in New Tab toggle (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Save Visual Experience settings (doc step)",
      "expected": {
        "labelEquals": "Save",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Save Visual Experience settings (doc step)", "timeoutMs": 90000 }
  ]
}
