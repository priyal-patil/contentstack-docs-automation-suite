{
  "id": "edit-a-management-token",
  "project": "CMS",
  "module": "tokens",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-tokens/edit-a-management-token",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "More (doc step)",
      "optional": true
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Tokens in settings left nav (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Tokens",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Tokens in settings left nav (doc step)"
    },
    {
      "action": "verify",
      "target": "Management Tokens tab (doc step)",
      "expected": {
        "labelEquals": "Management Tokens",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Management Tokens tab (doc step)"
    },
    {
      "action": "click",
      "target": "First management token row (doc step)"
    },
    {
      "action": "verify",
      "target": "Edit Management Token heading (doc step)",
      "expected": {
        "labelEquals": "Edit Management Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Management token Name label (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Management token Description label (doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Scope label (doc step)",
      "expected": {
        "labelEquals": "Scope",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Permissions label (doc step)",
      "expected": {
        "labelEquals": "Permissions",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Expiry label (doc step)",
      "expected": {
        "labelEquals": "Expiry",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Manage Rate Limits label (doc step)",
      "expected": {
        "labelEquals": "Manage Rate Limits",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Rate limit type label (doc step)",
      "expected": {
        "labelEquals": "Select Rate Limit Type",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Stack API Key (management token page doc step)",
      "expected": {
        "labelEquals": "Stack API Key",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Management token help text (edit doc step)",
      "expected": {
        "labelEquals": "Management Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Name input (management token doc step)",
      "value": "APPEND: edited"
    },
    {
      "action": "enter",
      "target": "Description input (management token doc step)",
      "value": "APPEND: edited"
    },
    {
      "action": "click",
      "target": "Save management token button (doc step)"
    }
  ]
}
