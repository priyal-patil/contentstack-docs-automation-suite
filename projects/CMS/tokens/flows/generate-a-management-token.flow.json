{
  "id": "generate-a-management-token",
  "project": "CMS",
  "module": "tokens",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-tokens/generate-a-management-token",
  "type": "executable",
  "use": ["login"],
  "steps": [
    { "action": "click", "target": "Headless CMS", "timeoutMs": 90000 },
    { "action": "click", "target": "Any Stack Card (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "More (doc step)" },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Settings (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Tokens in settings left nav (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Tokens",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Tokens in settings left nav (doc step)" },
    {
      "action": "verify",
      "target": "Management Tokens tab (doc step)",
      "expected": {
        "labelEquals": "Management Tokens",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Management Tokens tab (doc step)" },
    {
      "action": "verify",
      "target": "Management Tokens list page title (doc step)",
      "expected": {
        "labelEquals": "Tokens",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Management Token button (doc step)" },
    {
      "action": "verify",
      "target": "Create management token page marker (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Management Token fields coverage (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    { "action": "enter", "target": "Name input (management token doc step)", "value": "mgmt-token-{unique25}" },
    { "action": "enter", "target": "Description input (management token doc step)", "value": "Generated by automation {unique25}" },
    { "action": "click", "target": "Read permission checkbox (doc step)" },
    { "action": "click", "target": "Write permission checkbox (doc step)" },
    {
      "action": "verify",
      "target": "Stack API Key (management token page doc step)",
      "expected": {
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Generate Token button (doc step)" },
    {
      "action": "verify",
      "target": "Management Token Generated modal title (doc step)",
      "expected": {
        "modalTitle": "Management Token Generated!",
        "labelEquals": "Management Token Generated!",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Stack API Key in generated modal (doc step)",
      "expected": {
        "labelEquals": "Stack API Key",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Management Token in generated modal (doc step)",
      "expected": {
        "labelEquals": "Management Token",
        "labelMatch": "contains"
      }
    },
    { "action": "click", "target": "Done button in token generated modal (doc step)" }
  ]
}
