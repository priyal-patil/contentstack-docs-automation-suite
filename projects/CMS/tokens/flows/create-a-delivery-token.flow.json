{
  "id": "create-a-delivery-token",
  "project": "CMS",
  "module": "tokens",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/create-tokens/create-a-delivery-token",
  "type": "executable",
  "use": [
    "login"
  ],
  "steps": [
    {
      "action": "click",
      "target": "Headless CMS",
      "timeoutMs": 30000
    },
    {
      "action": "click",
      "target": "Any Stack Card (doc step)",
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Settings (doc step)",
      "expected": {
        "within": "Left Navigation",
        "withinStrict": true,
        "labelEquals": "Settings",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Settings (doc step)",
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Tokens in settings left nav (doc step)",
      "expected": {
        "withinStrict": true,
        "labelEquals": "Tokens",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Tokens in settings left nav (doc step)"
    },
    {
      "action": "verify",
      "target": "Delivery Tokens tab (doc step)",
      "expected": {
        "labelEquals": "Delivery Tokens",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delivery Tokens tab (doc step)"
    },
    {
      "action": "verify",
      "target": "Delivery Token button (doc step)",
      "expected": {
        "labelEquals": "Delivery Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Delivery Token button (doc step)"
    },
    {
      "action": "verify",
      "target": "Delivery token Name label (doc step)",
      "expected": {
        "labelEquals": "Name",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Name input (delivery token doc step)",
      "value": "delivery-token-{unique25}"
    },
    {
      "action": "verify",
      "target": "Delivery token Description label (doc step)",
      "expected": {
        "labelEquals": "Description",
        "labelMatch": "contains"
      }
    },
    {
      "action": "enter",
      "target": "Description input (delivery token doc step)",
      "value": "Generated by automation {unique25}"
    },
    {
      "action": "verify",
      "target": "Delivery token Scope label (doc step)",
      "expected": {
        "labelEquals": "Scope",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Branches label in scope (doc step)",
      "expected": {
        "labelEquals": "Branches",
        "labelMatch": "contains"
      },
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Branches dropdown (delivery token doc step)",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "First branch option in scope (delivery token doc step)",
      "warnOnly": true,
      "timeoutMs": 5000
    },
    {
      "action": "verify",
      "target": "Publishing Environments label (doc step)",
      "expected": {
        "labelEquals": "Publishing Environments",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "First publishing environment radio (delivery token doc step)"
    },
    {
      "action": "verify",
      "target": "Create Preview Token toggle (doc step)",
      "timeoutMs": 90000,
      "expected": {
        "labelEquals": "Create Preview Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Generate delivery token button (doc step)",
      "expected": {
        "labelEquals": "Generate Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "Generate delivery token button (doc step)"
    },
    {
      "action": "verify",
      "target": "Stack API Key (delivery token page doc step)",
      "expected": {
        "labelEquals": "Stack API Key",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Delivery Token value in edit page (doc step)",
      "expected": {
        "labelEquals": "Delivery Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "verify",
      "target": "Preview Token value in edit page (doc step)",
      "expected": {
        "labelEquals": "Preview Token",
        "labelMatch": "contains"
      }
    },
    {
      "action": "capture",
      "target": "Stack API Key value (delivery token doc step)"
    },
    {
      "action": "capture",
      "target": "Delivery Token value (delivery token doc step)"
    },
    {
      "action": "capture",
      "target": "Preview Token value (delivery token doc step)"
    }
  ]
}
