{
  "id": "installing-apps",
  "project": "Marketplace",
  "module": "install-apps",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/marketplace-platform-guides/installing-apps",
  "type": "executable",
  "use": ["login", "orgDashboard"],
