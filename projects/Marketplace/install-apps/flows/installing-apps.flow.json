      "expected": {
        "within": "Top navigation",
        "labelMatch": "contains"
      }
    },
    {
      "action": "click",
      "target": "App Switcher button (doc step)",
      "timeoutMs": 60000,
      "docWarning": "App Switcher click is automation-added; not described in the doc."
    },
