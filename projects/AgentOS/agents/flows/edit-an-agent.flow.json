{
  "id": "edit-an-agent",
  "project": "AgentOS",
  "module": "agents",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/edit-an-agent",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Agent OS (doc step)",
      "expected": { "labelEquals": "Agent OS", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Agent OS (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any existing project card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Agents in top navigation panel (doc step)",
      "expected": { "labelEquals": "Agents", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Agents in top navigation panel (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "vertical ellipses on an agent (doc step)",
      "docWarning": "No user-created agents exist in the test account — agent list is empty. This step requires an agent to have been created first. Marking as warnOnly.",
      "warnOnly": true,
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Edit Agent option in dropdown (doc step)",
      "warnOnly": true,
      "expected": { "labelEquals": "Edit Agent", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Edit Agent option in dropdown (doc step)",
      "warnOnly": true,
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Agent Builder screen (doc step)",
      "warnOnly": true,
      "expected": { "labelEquals": "Agent Builder", "labelMatch": "contains" },
      "timeoutMs": 90000
    }
  ]
}
