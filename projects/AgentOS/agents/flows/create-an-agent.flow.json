{
  "id": "create-an-agent",
  "project": "AgentOS",
  "module": "agents",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/create-an-agent",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Agent OS (doc step)",
      "expected": { "labelEquals": "Agent OS", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Agent OS (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Any existing project card (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Agents in top navigation panel (doc step)",
      "docWarning": "Doc says 'Navigate to the Agents page' without detailing the navigation — clicking Agents in the top nav added as required step.",
      "expected": { "labelEquals": "Agents", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Agents in top navigation panel (doc step)",
      "docWarning": "Doc says 'Navigate to the Agents page' without detailing the navigation — clicking Agents in the top nav added as required step.",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Agent button (doc step)",
      "docWarning": "Doc says '+ New Agent' but UI button text is 'create agent' (lowercase, different label) — doc/UI label mismatch.",
      "warnOnly": true,
      "expected": { "labelEquals": "+ New Agent", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "+ New Agent button (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Create manually option in New Agent dropdown (doc step)",
      "docWarning": "Clicking '+ New Agent' opens a dropdown with Browse Templates / Create Manually / Import options. Doc flow describes 'Create Agent modal' which appears via Browse Templates, but Create Manually goes directly to the manual form.",
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Create Agent modal (doc step)",
      "warnOnly": true,
      "expected": { "labelEquals": "Create Agent", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Skip, I'll create manually link (doc step)",
      "warnOnly": true,
      "expected": { "labelEquals": "Skip, I'll create manually", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Skip, I'll create manually link (doc step)",
      "warnOnly": true,
      "timeoutMs": 30000
    },
    {
      "action": "verify",
      "target": "Title field (doc step)",
      "expected": { "labelEquals": "Title", "labelMatch": "contains" }
    },
    {
      "action": "enter",
      "target": "Title input (doc step)",
      "value": "agent-{unique5}"
    },
    {
      "action": "verify",
      "target": "Description field in Create Agent (doc step)",
      "expected": { "labelEquals": "Description", "labelMatch": "contains" }
    },
    {
      "action": "enter",
      "target": "Description input in Create Agent (doc step)",
      "value": "agent-description-{unique5}"
    },
    {
      "action": "verify",
      "target": "Create Agent button (doc step)",
      "expected": { "labelEquals": "Create Agent", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Create Agent button (doc step)",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Agent Builder page (doc step)",
      "expected": { "labelEquals": "Agent Builder", "labelMatch": "contains" },
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Trigger component (doc step)",
      "expected": { "labelEquals": "Trigger", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Tools component (doc step)",
      "expected": { "labelEquals": "Tools", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Instructions component (doc step)",
      "expected": { "labelEquals": "Instructions", "labelMatch": "contains" }
    }
  ]
}
