{
  "id": "about-contentstack-management-actions",
  "project": "AgentOS",
  "module": "contentstack-management-actions",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/about-contentstack-management-actions",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "CS-Management-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Contentstack connector in the Choose Connector list",
      "labelEquals": "Contentstack",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Contentstack connector in the Choose Connector list",
      "labelEquals": "Contentstack",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Contentstack Management option in the connector list",
      "labelEquals": "Contentstack Management",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Contentstack Management option in the connector list",
      "labelEquals": "Contentstack Management",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Asset action category in Choose an Action",
      "labelEquals": "Asset",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Branch action category in Choose an Action",
      "labelEquals": "Branch",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Branch Alias action category in Choose an Action",
      "labelEquals": "Branch Alias",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Content Type action category in Choose an Action",
      "labelEquals": "Content Type",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Entry action category in Choose an Action",
      "labelEquals": "Entry",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Global Fields action category in Choose an Action",
      "labelEquals": "Global Fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Locales action category in Choose an Action",
      "labelEquals": "Locales",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Release action category in Choose an Action",
      "labelEquals": "Release",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Taxonomy action category in Choose an Action",
      "labelEquals": "Taxonomy",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "User action category in Choose an Action",
      "labelEquals": "User",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Variant action category in Choose an Action",
      "labelEquals": "Variant",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Content Type action category in Choose an Action",
      "labelEquals": "Content Type",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Get All Content Types action option",
      "labelEquals": "Get All Content Types",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Get All Content Types action option",
      "labelEquals": "Get All Content Types",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "detect",
      "target": "contentstack-management-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Contentstack Management account in account list",
      "onlyIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected"
    },
    {
      "action": "verify",
      "target": "Contentstack OAuth authentication method option",
      "labelEquals": "Contentstack",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Management Token authentication method option",
      "labelEquals": "Management Token",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Contentstack OAuth authentication method option",
      "labelEquals": "Contentstack",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button in authentication method selection",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button in authentication method selection",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "checkbox for all permissions in the Manage Permissions modal",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Authorize button in the Manage Permissions modal",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Authorize button in the Manage Permissions modal",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "organization option in the pop-up",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Authorize button in the module access rights pop-up",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Account Name field",
      "value": "CS Management Account",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "csManagementAccountAlreadySelected",
      "warnOnly": true
    }
  ]
}
