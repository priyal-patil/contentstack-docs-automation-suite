{
  "id": "elasticsearch",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/elasticsearch",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Elasticsearch-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Elasticsearch connector in the Choose Connector list",
      "labelEquals": "Elasticsearch",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Elasticsearch connector in the Choose Connector list",
      "labelEquals": "Elasticsearch",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Index an Entry action option in Choose an Action",
      "labelEquals": "Index an Entry",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Index an Entry action option in Choose an Action",
      "labelEquals": "Index an Entry",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "elasticsearch-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Elasticsearch account in account list",
      "onlyIfFlowFlagTrue": "elasticsearchAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Node URL field in account setup",
      "labelEquals": "Node URL",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Node URL field in account setup",
      "value": "{{ELASTICSEARCH_NODE_URL}}",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Elasticsearch Node URL is required; copy it from the endpoint for the Elasticsearch section on your deployment page."
    },
    {
      "action": "verify",
      "target": "Username field in account setup",
      "labelEquals": "Username",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Username field in account setup",
      "value": "{{ELASTICSEARCH_USERNAME}}",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Elasticsearch Username is required; it is provided when you create a deployment."
    },
    {
      "action": "verify",
      "target": "Password field in account setup",
      "labelEquals": "Password",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Password field in account setup",
      "value": "{{ELASTICSEARCH_PASSWORD}}",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Elasticsearch Password is required; it is provided when you create a deployment."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "elasticsearchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Index name field",
      "labelEquals": "Index name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Index name field",
      "value": "test-index",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Body field",
      "labelEquals": "Body",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Body field",
      "value": "{}",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
