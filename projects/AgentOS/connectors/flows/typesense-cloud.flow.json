      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Index an Entry action option in Choose an Action",
      "labelEquals": "Index an Entry",
      "labelMatch": "contains"
    },
