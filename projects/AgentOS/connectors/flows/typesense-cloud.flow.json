    {
      "action": "detect",
      "target": "typesense-cloud-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Typesense Cloud account in account list",
      "onlyIfFlowFlagTrue": "typesenseCloudAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "typesenseCloudAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "typesenseCloudAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "API Key field in account setup",
      "labelEquals": "API Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "typesenseCloudAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "API Key field in account setup",
      "value": "{{TYPESENSE_CLOUD_API_KEY}}",
      "skipIfFlowFlagTrue": "typesenseCloudAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Typesense Cloud Admin API Key is required; obtain it from Typesense Cloud dashboard under Overview > Generate API Keys."
    },
    {
      "action": "verify",
      "target": "Typesense Host Node URL field in account setup",
      "labelEquals": "Typesense Host Node URL",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "typesenseCloudAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Typesense Host Node URL field in account setup",
