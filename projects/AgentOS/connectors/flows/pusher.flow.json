{
  "id": "pusher",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/pusher",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Pusher-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Pusher connector in the Choose Connector list",
      "labelEquals": "Pusher",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Pusher connector in the Choose Connector list",
      "labelEquals": "Pusher",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Send Message action option in Choose an Action",
      "labelEquals": "Send Message",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Send Message action option in Choose an Action",
      "labelEquals": "Send Message",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "pusher-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Pusher account in account list",
      "onlyIfFlowFlagTrue": "pusherAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "App ID field in account setup",
      "labelEquals": "App ID",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "App ID field in account setup",
      "value": "{{PUSHER_APP_ID}}",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Pusher App ID is required; find it in Pusher Dashboard → your app → App Keys."
    },
    {
      "action": "verify",
      "target": "App Key field in account setup",
      "labelEquals": "App Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "App Key field in account setup",
      "value": "{{PUSHER_APP_KEY}}",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Pusher App Key is required; find it in Pusher Dashboard → your app → App Keys."
    },
    {
      "action": "verify",
      "target": "App Secret Key field in account setup",
      "labelEquals": "App Secret Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "App Secret Key field in account setup",
      "value": "{{PUSHER_APP_SECRET_KEY}}",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Pusher App Secret Key is required; find it in Pusher Dashboard → your app → App Keys."
    },
    {
      "action": "verify",
      "target": "Cluster field in account setup",
      "labelEquals": "Cluster",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Cluster field in account setup",
      "value": "{{PUSHER_CLUSTER}}",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Pusher Cluster is required; find it in Pusher Dashboard → your app → App Keys (e.g. mt1, eu, ap1)."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "pusherAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Channel name dropdown field",
      "labelEquals": "Channel name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Channel name dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any channel option in the Channel name dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Event Name field",
      "labelEquals": "Event Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Event Name field",
      "value": "test-event",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Message field",
      "labelEquals": "Message",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Message field",
      "value": "Test message",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
