{
  "id": "cloudinary",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/cloudinary",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Cloudinary-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Cloudinary connector in the Choose Connector list",
      "labelEquals": "Cloudinary",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Cloudinary connector in the Choose Connector list",
      "labelEquals": "Cloudinary",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Update Metadata action option in Choose an Action",
      "labelEquals": "Update Metadata",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Update Metadata action option in Choose an Action",
      "labelEquals": "Update Metadata",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "cloudinary-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Cloudinary account in account list",
      "onlyIfFlowFlagTrue": "cloudinaryAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Cloud Name field in account setup",
      "labelEquals": "Cloud Name",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Cloud Name field in account setup",
      "value": "{{CLOUDINARY_CLOUD_NAME}}",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Cloudinary Cloud Name is required; obtain it from the Cloudinary dashboard under Product Environment."
    },
    {
      "action": "verify",
      "target": "API Key field in account setup",
      "labelEquals": "API Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "API Key field in account setup",
      "value": "{{CLOUDINARY_API_KEY}}",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Cloudinary API Key is required; obtain it from Cloudinary dashboard → API Keys."
    },
    {
      "action": "verify",
      "target": "API Secret field in account setup",
      "labelEquals": "API Secret",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "API Secret field in account setup",
      "value": "{{CLOUDINARY_API_SECRET}}",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Cloudinary API Secret is required; generate it via Cloudinary dashboard → API Keys → Generate New API Key."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "cloudinaryAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "MetaData lookup field",
      "labelEquals": "MetaData",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "MetaData lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any metadata option in the MetaData lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Body field",
      "labelEquals": "Body",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Body field",
      "value": "{}",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
