{
  "id": "circleci",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/circleci",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "CircleCI-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "CircleCI connector in the Choose Connector list",
      "labelEquals": "CircleCI",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "CircleCI connector in the Choose Connector list",
      "labelEquals": "CircleCI",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Trigger a Pipeline action option in Choose an Action",
      "labelEquals": "Trigger a Pipeline",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Trigger a Pipeline action option in Choose an Action",
      "labelEquals": "Trigger a Pipeline",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "circleci-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing CircleCI account in account list",
      "onlyIfFlowFlagTrue": "circleCIAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "CircleCI Account",
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "API Token field in account setup",
      "labelEquals": "API Token",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "API Token field in account setup",
      "value": "{{CIRCLECI_API_TOKEN}}",
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real CircleCI API Token is required; generate it from CircleCI console → User Settings → Personal API Tokens → Create New Token."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "circleCIAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "VCS type dropdown field",
      "labelEquals": "VCS type",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "VCS type dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any option in the VCS type dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Organization name field",
      "labelEquals": "Organization name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Organization name field",
      "value": "my-org",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Repository name field",
      "labelEquals": "Repository name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Repository name field",
      "value": "my-repo",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Branch/Tag dropdown field",
      "labelEquals": "Branch/Tag",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Branch/Tag dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any option in the Branch/Tag dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Branch/Tag name field",
      "labelEquals": "Branch/Tag name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Branch/Tag name field",
      "value": "main",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
