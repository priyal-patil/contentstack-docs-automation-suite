{
  "id": "aws-lambda",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/aws-lambda",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "AWSLambda-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "AWS Lambda connector in the Choose Connector list",
      "labelEquals": "AWS Lambda",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "AWS Lambda connector in the Choose Connector list",
      "labelEquals": "AWS Lambda",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Execute Lambda Function action option in Choose an Action",
      "labelEquals": "Execute Lambda Function",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Execute Lambda Function action option in Choose an Action",
      "labelEquals": "Execute Lambda Function",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "aws-lambda-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing AWS Lambda account in account list",
      "onlyIfFlowFlagTrue": "awsLambdaAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "AWS Lambda Account",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Access Key field in account setup",
      "labelEquals": "Access Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Access Key field in account setup",
      "value": "{{AWS_LAMBDA_ACCESS_KEY}}",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Access Key is required; obtain it from AWS console → Security credentials → Access Keys → Create New Access Key."
    },
    {
      "action": "verify",
      "target": "Secret Key field in account setup",
      "labelEquals": "Secret Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Secret Key field in account setup",
      "value": "{{AWS_LAMBDA_SECRET_KEY}}",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Secret Key is required; obtain it from AWS console → Security credentials → Access Keys → Create New Access Key."
    },
    {
      "action": "verify",
      "target": "Region field in account setup",
      "labelEquals": "Region",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Region field in account setup",
      "value": "{{AWS_LAMBDA_REGION}}",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Region is required for this step."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "awsLambdaAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Function Name lookup field",
      "labelEquals": "Function Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Function Name lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any function option in the Function Name lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Invocation Type dropdown field",
      "labelEquals": "Invocation Type",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Invocation Type dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Event option in the Invocation Type dropdown",
      "labelEquals": "Event",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "RequestResponse option in the Invocation Type dropdown",
      "labelEquals": "RequestResponse",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "DryRun option in the Invocation Type dropdown",
      "labelEquals": "DryRun",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "RequestResponse option in the Invocation Type dropdown",
      "labelEquals": "RequestResponse",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Parameters field after enabling Show optional fields",
      "labelEquals": "Parameters",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Specific Version or Tag field after enabling Show optional fields",
      "labelEquals": "Specific Version or Tag",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
