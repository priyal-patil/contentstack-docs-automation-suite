    {
      "action": "click",
      "target": "existing Algolia account in account list",
      "onlyIfFlowFlagTrue": "algoliaAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
