    {
      "action": "enter",
      "target": "Application ID field in account setup",
      "value": "{{ALGOLIA_APPLICATION_ID}}",
      "skipIfFlowFlagTrue": "algoliaAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Algolia Application ID is required for this step; obtain it from the Algolia dashboard."
