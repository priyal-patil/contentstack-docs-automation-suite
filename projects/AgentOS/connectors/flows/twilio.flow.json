{
  "id": "twilio",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/twilio",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Twilio-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Twilio connector in the Choose Connector list",
      "labelEquals": "Twilio",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Twilio connector in the Choose Connector list",
      "labelEquals": "Twilio",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Send SMS action option in Choose an Action",
      "labelEquals": "Send SMS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Send SMS action option in Choose an Action",
      "labelEquals": "Send SMS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "twilio-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Twilio account in account list",
      "onlyIfFlowFlagTrue": "twilioAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Account SID field in account setup",
      "labelEquals": "Account SID",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Account SID field in account setup",
      "value": "{{TWILIO_ACCOUNT_SID}}",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Twilio Account SID is required; find it in Twilio Console → Account Info."
    },
    {
      "action": "verify",
      "target": "Token field in account setup",
      "labelEquals": "Token",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Token field in account setup",
      "value": "{{TWILIO_AUTH_TOKEN}}",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Twilio Auth Token is required; find it in Twilio Console → Account Info."
    },
    {
      "action": "verify",
      "target": "Caller ID lookup field in account setup",
      "labelEquals": "Caller ID",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Caller ID lookup field in account setup",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any phone number option in the Caller ID lookup",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "twilioAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "To field",
      "labelEquals": "To",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "To field",
      "value": "+10000000000",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Message field",
      "labelEquals": "Message",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Message field",
      "value": "Test SMS message",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
