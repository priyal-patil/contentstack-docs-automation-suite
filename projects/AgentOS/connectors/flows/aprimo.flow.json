{
  "id": "aprimo",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/aprimo",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Aprimo-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Aprimo connector in the Choose Connector list",
      "labelEquals": "Aprimo",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Aprimo connector in the Choose Connector list",
      "labelEquals": "Aprimo",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Edit a Record action option in Choose an Action",
      "labelEquals": "Edit a Record",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Get Single Record action option in Choose an Action",
      "labelEquals": "Get Single Record",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Edit a Record action option in Choose an Action",
      "labelEquals": "Edit a Record",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "aprimo-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Aprimo account in account list",
      "onlyIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "Aprimo Account",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Aprimo URL field in account setup",
      "labelEquals": "Aprimo URL",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Aprimo URL field in account setup",
      "value": "{{APRIMO_URL}}",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Aprimo URL is required for this step."
    },
    {
      "action": "verify",
      "target": "Client ID field in account setup",
      "labelEquals": "Client ID",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Client ID field in account setup",
      "value": "{{APRIMO_CLIENT_ID}}",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Aprimo Client ID is required; generate it from Aprimo dashboard → Administration → Integration → Registrations with OAuth Flow Type set to Client Credential."
    },
    {
      "action": "verify",
      "target": "Client Secret field in account setup",
      "labelEquals": "Client Secret",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Client Secret field in account setup",
      "value": "{{APRIMO_CLIENT_SECRET}}",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Aprimo Client Secret is required; generate it from Aprimo dashboard → Administration → Integration → Registrations."
    },
    {
      "action": "verify",
      "target": "Authorize button in account setup",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Authorize button in account setup",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Account Name field in account setup",
      "labelEquals": "Account Name",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Account Name field in account setup",
      "value": "Aprimo Account",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "aprimoAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Asset lookup field",
      "labelEquals": "Asset",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Asset lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any asset option in the Asset lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Asset Attribute section",
      "labelEquals": "Asset Attribute",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Key field in Asset Attribute",
      "labelEquals": "Key",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Key field in Asset Attribute",
      "value": "attributeKey",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Value field in Asset Attribute",
      "labelEquals": "Value",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Value field in Asset Attribute",
      "value": "attributeValue",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Action Step card at the bottom of the automation",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card at the bottom of the automation",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Aprimo connector in the Choose Connector list",
      "labelEquals": "Aprimo",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Aprimo connector in the Choose Connector list",
      "labelEquals": "Aprimo",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Get Single Record action option in Choose an Action",
      "labelEquals": "Get Single Record",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Get Single Record action option in Choose an Action",
      "labelEquals": "Get Single Record",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "existing Aprimo account in account list",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Record ID lookup field",
      "labelEquals": "Record ID",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Record ID lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any record option in the Record ID lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
