{
  "id": "constructor",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/constructor",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Constructor-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Constructor connector in the Choose Connector list",
      "labelEquals": "Constructor",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Constructor connector in the Choose Connector list",
      "labelEquals": "Constructor",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Index an Entry action option in Choose an Action",
      "labelEquals": "Index an Entry",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Delete an Entry action option in Choose an Action",
      "labelEquals": "Delete an Entry",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Index an Entry action option in Choose an Action",
      "labelEquals": "Index an Entry",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "constructor-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Constructor account in account list",
      "onlyIfFlowFlagTrue": "constructorAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "API Token field in account setup",
      "labelEquals": "API Token",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "API Token field in account setup",
      "value": "{{CONSTRUCTOR_API_TOKEN}}",
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Constructor API Token is required; generate it from the Constructor dashboard Integration tab."
    },
    {
      "action": "verify",
      "target": "INDEX KEY field in account setup",
      "labelEquals": "INDEX KEY",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "INDEX KEY field in account setup",
      "value": "{{CONSTRUCTOR_INDEX_KEY}}",
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Constructor INDEX KEY is required; copy it from Workspace > Indexes in the Constructor dashboard."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "constructorAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "id field",
      "labelEquals": "id",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "id field",
      "value": "item-001",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "name field",
      "labelEquals": "name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "name field",
      "value": "Sample Item",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "data field",
      "labelEquals": "data",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "URL field",
      "labelEquals": "URL",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Index Section dropdown after enabling Show Optional Fields",
      "labelEquals": "Index Section",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Email Address field after enabling Show Optional Fields",
      "labelEquals": "Email Address",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Action Step card at the bottom of the automation",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card at the bottom of the automation",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Constructor connector in the Choose Connector list",
      "labelEquals": "Constructor",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Constructor connector in the Choose Connector list",
      "labelEquals": "Constructor",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Delete an Entry action option in Choose an Action",
      "labelEquals": "Delete an Entry",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Delete an Entry action option in Choose an Action",
      "labelEquals": "Delete an Entry",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "existing Constructor account in account list",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "id field",
      "labelEquals": "id",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "id field",
      "value": "item-001",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Index Section dropdown after enabling Show Optional Fields",
      "labelEquals": "Index Section",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Email Address field after enabling Show Optional Fields",
      "labelEquals": "Email Address",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
