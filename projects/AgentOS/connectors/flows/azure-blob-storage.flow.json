{
  "id": "azure-blob-storage",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/azure-blob-storage",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "AzureBlobStorage-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Azure Blob Storage connector in the Choose Connector list",
      "labelEquals": "Azure Blob Storage",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Azure Blob Storage connector in the Choose Connector list",
      "labelEquals": "Azure Blob Storage",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create or Upload a Blob action option in Choose an Action",
      "labelEquals": "Create or Upload a Blob",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create or Upload a Blob action option in Choose an Action",
      "labelEquals": "Create or Upload a Blob",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "azure-blob-storage-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Azure Blob Storage account in account list",
      "onlyIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "Azure Blob Storage Account",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Storage Account Name field in account setup",
      "labelEquals": "Storage Account Name",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Storage Account Name field in account setup",
      "value": "{{AZURE_BLOB_STORAGE_ACCOUNT_NAME}}",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Azure Storage Account Name is required; copy it from your Azure Storage Account Access keys."
    },
    {
      "action": "verify",
      "target": "SAS Token field in account setup",
      "labelEquals": "SAS Token",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "SAS Token field in account setup",
      "value": "{{AZURE_BLOB_SAS_TOKEN}}",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Azure SAS Token is required; generate it from Azure Storage Account → Shared access signature with Blob service, Read/Write/Delete/List/Add/Create permissions."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "azureBlobStorageAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Container Name lookup field",
      "labelEquals": "Container Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Container Name lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any container option in the Container Name lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "File Name field",
      "labelEquals": "File Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "File Name field",
      "value": "File01.txt",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Access Tier dropdown field",
      "labelEquals": "Access Tier",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Access Tier dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Hot option in the Access Tier dropdown",
      "labelEquals": "Hot",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Cool option in the Access Tier dropdown",
      "labelEquals": "Cool",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Cold option in the Access Tier dropdown",
      "labelEquals": "Cold",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Archive option in the Access Tier dropdown",
      "labelEquals": "Archive",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Hot option in the Access Tier dropdown",
      "labelEquals": "Hot",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Source dropdown field",
      "labelEquals": "Source",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Source dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Content option in the Source dropdown",
      "labelEquals": "Content",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "File URL option in the Source dropdown",
      "labelEquals": "File URL",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Content option in the Source dropdown",
      "labelEquals": "Content",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Input Value field",
      "labelEquals": "Input Value",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Input Value field",
      "value": "Sample blob content",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Blob Tags field after enabling Show optional fields",
      "labelEquals": "Blob Tags",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Metadata field after enabling Show optional fields",
      "labelEquals": "Metadata",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
