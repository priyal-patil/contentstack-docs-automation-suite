{
  "id": "anthropic",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/anthropic",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Anthropic-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "Action Step card",
      "timeoutMs": 90000,
      "docWarning": "The document does not describe clicking the Action Step card, but it is required to open the connector selection panel."
    },
    {
      "action": "verify",
      "target": "Anthropic connector in the Choose Connector list",
      "labelEquals": "Anthropic",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Anthropic connector in the Choose Connector list",
      "labelEquals": "Anthropic",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Chat action option in Choose an Action",
      "labelEquals": "Chat",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Chat action option in Choose an Action",
      "labelEquals": "Chat",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "detect",
      "target": "anthropic-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Anthropic account in account list",
      "onlyIfFlowFlagTrue": "anthropicAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "Anthropic Account",
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "API Key field in account setup",
      "labelEquals": "API Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "API Key field in account setup",
      "value": "{{ANTHROPIC_API_KEY}}",
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Anthropic API Key credentials are required for this step; the test will warn if the value is not configured."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "anthropicAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Model dropdown field",
      "labelEquals": "Model",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Model dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any model option in the Model dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "System Instruction Text field",
      "labelEquals": "System Instruction Text",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "System Instruction Text field",
      "value": "You are a helpful assistant.",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Role dropdown field",
      "labelEquals": "Role",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Role dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "user option in the Role dropdown",
      "labelEquals": "user",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "assistant option in the Role dropdown",
      "labelEquals": "assistant",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "user option in the Role dropdown",
      "labelEquals": "user",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Prompt Text field",
      "labelEquals": "Prompt Text",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "+ Add Prompt Input button",
      "labelEquals": "+ Add Prompt Input",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "+ Add Prompt Input button",
      "labelEquals": "+ Add Prompt Input",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Select Prompt Type dropdown",
      "labelEquals": "Select Prompt Type",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Select Prompt Type dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Text option in Select Prompt Type dropdown",
      "labelEquals": "Text",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Image option in Select Prompt Type dropdown",
      "labelEquals": "Image",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Text option in Select Prompt Type dropdown",
      "labelEquals": "Text",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Prompt Value field",
      "labelEquals": "Prompt Value",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Prompt Value field",
      "value": "Hello",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Number of Tokens field after enabling Show Optional Fields",
      "labelEquals": "Number of Tokens",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Sanitize text checkbox after enabling Show Optional Fields",
      "labelEquals": "Sanitize text",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Reasoning checkbox after enabling Show Optional Fields",
      "labelEquals": "Reasoning",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Randomness of Responses field after enabling Show Optional Fields",
      "labelEquals": "Randomness of Responses",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Top-P field after enabling Show Optional Fields",
      "labelEquals": "Top-P",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Top-K field after enabling Show Optional Fields",
      "labelEquals": "Top-K",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
