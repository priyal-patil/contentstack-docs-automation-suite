{
  "id": "aws-sqs",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/aws-sqs",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "AWSSQS-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "AWS SQS connector in the Choose Connector list",
      "labelEquals": "AWS SQS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "AWS SQS connector in the Choose Connector list",
      "labelEquals": "AWS SQS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Send Message action option in Choose an Action",
      "labelEquals": "Send Message",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Send Message action option in Choose an Action",
      "labelEquals": "Send Message",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "aws-sqs-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing AWS SQS account in account list",
      "onlyIfFlowFlagTrue": "awsSqsAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "AWS SQS Account",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Access Key field in account setup",
      "labelEquals": "Access Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Access Key field in account setup",
      "value": "{{AWS_SQS_ACCESS_KEY}}",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Access Key is required; generate it from AWS Console → IAM → Users → Security credentials → Create access key."
    },
    {
      "action": "verify",
      "target": "Secret Key field in account setup",
      "labelEquals": "Secret Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Secret Key field in account setup",
      "value": "{{AWS_SQS_SECRET_KEY}}",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Secret Key is required; generated alongside the Access Key from AWS Console → IAM."
    },
    {
      "action": "verify",
      "target": "Region field in account setup",
      "labelEquals": "Region",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Region field in account setup",
      "value": "{{AWS_SQS_REGION}}",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Region is required (e.g. us-east-1); find it in AWS Console → SQS."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "awsSqsAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Queue URL lookup field",
      "labelEquals": "Queue URL",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Queue URL lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any queue option in the Queue URL lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Queue Type dropdown field",
      "labelEquals": "Queue Type",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Queue Type dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Standard option in the Queue Type dropdown",
      "labelEquals": "Standard",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "FIFO option in the Queue Type dropdown",
      "labelEquals": "FIFO",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Standard option in the Queue Type dropdown",
      "labelEquals": "Standard",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Message Body field",
      "labelEquals": "Message Body",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Message Body field",
      "value": "Test SQS message",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Message Attributes field after enabling Show optional fields",
      "labelEquals": "Message Attributes",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Delay Seconds field after enabling Show optional fields",
      "labelEquals": "Delay Seconds",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Message Group Id field after enabling Show optional fields",
      "labelEquals": "Message Group Id",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Message Deduplication Id field after enabling Show optional fields",
      "labelEquals": "Message Deduplication Id",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
