{
  "id": "aws-bedrock",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/aws-bedrock",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "AWSBedrock-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "AWS Bedrock connector in the Choose Connector list",
      "labelEquals": "AWS Bedrock",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "AWS Bedrock connector in the Choose Connector list",
      "labelEquals": "AWS Bedrock",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Prompt action option in Choose an Action",
      "labelEquals": "Prompt",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Prompt action option in Choose an Action",
      "labelEquals": "Prompt",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "detect",
      "target": "aws-bedrock-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing AWS Bedrock account in account list",
      "onlyIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "AWS Bedrock Account",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Access Key field in account setup",
      "labelEquals": "Access Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Access Key field in account setup",
      "value": "{{AWS_BEDROCK_ACCESS_KEY}}",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Access Key is required for this step; the test will warn if the value is not configured."
    },
    {
      "action": "verify",
      "target": "Secret Key field in account setup",
      "labelEquals": "Secret Key",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Secret Key field in account setup",
      "value": "{{AWS_BEDROCK_SECRET_KEY}}",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Secret Key is required for this step; the test will warn if the value is not configured."
    },
    {
      "action": "verify",
      "target": "Region field in account setup",
      "labelEquals": "Region",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Region field in account setup",
      "value": "{{AWS_BEDROCK_REGION}}",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real AWS Region is required for this step; the test will warn if the value is not configured."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "awsBedrockAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Foundation Model dropdown field",
      "labelEquals": "Foundation Model",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Foundation Model dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any model option in the Foundation Model dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Prompt Text field",
      "labelEquals": "Prompt Text",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Prompt Text field",
      "value": "Hello",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Number of Tokens field after enabling Show Optional Fields",
      "labelEquals": "Number of Tokens",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Randomness of Responses field after enabling Show Optional Fields",
      "labelEquals": "Randomness of Responses",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Top P (Nucleus sampling) field after enabling Show Optional Fields",
      "labelEquals": "Top P (Nucleus sampling)",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Sanitize text checkbox after enabling Show Optional Fields",
      "labelEquals": "Sanitize text",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
