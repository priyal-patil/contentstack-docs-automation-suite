{
  "id": "box-action",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/box-action",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "BoxAction-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Box connector in the Choose Connector list",
      "labelEquals": "Box",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Box connector in the Choose Connector list",
      "labelEquals": "Box",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Get File URL action option in Choose an Action",
      "labelEquals": "Get File URL",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Get File URL action option in Choose an Action",
      "labelEquals": "Get File URL",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "box-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Box account in account list",
      "onlyIfFlowFlagTrue": "boxAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "permission checkboxes in account setup",
      "labelEquals": "permission checkboxes",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "all permission checkboxes in account setup to select all permissions",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Authorize button in account setup",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Authorize button in account setup",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Grant access to Box button in the Box OAuth popup",
      "labelEquals": "Grant access to Box",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Grant access to Box button in the Box OAuth popup",
      "labelEquals": "Grant access to Box",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "OAuth authorization with Box is required; log in to Box in the popup and click Grant access to Box."
    },
    {
      "action": "verify",
      "target": "Account Name field in account setup",
      "labelEquals": "Account Name",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Account Name field in account setup",
      "value": "Box Account",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "boxAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Select Folder dropdown field",
      "labelEquals": "Select Folder",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Select Folder dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any folder option in the Select Folder dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Select File dropdown field",
      "labelEquals": "Select File",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Select File dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any file option in the Select File dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show Optional Fields toggle button",
      "labelEquals": "Show Optional Fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "File Version dropdown after enabling Show Optional Fields",
      "labelEquals": "File Version",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
