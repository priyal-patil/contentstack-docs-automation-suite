{
  "id": "launch",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/launch",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "Launch-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Launch connector in the Choose Connector list",
      "labelEquals": "Launch",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Launch connector in the Choose Connector list",
      "labelEquals": "Launch",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Deploy a Build action option in Choose an Action",
      "labelEquals": "Deploy a Build",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Revalidate CDN Cache action option in Choose an Action",
      "labelEquals": "Revalidate CDN Cache",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Deploy a Build action option in Choose an Action",
      "labelEquals": "Deploy a Build",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "launch-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Launch account in account list",
      "onlyIfFlowFlagTrue": "launchAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "OAuth permission checkboxes in account setup",
      "labelEquals": "permission checkboxes",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "all OAuth permission checkboxes in account setup to grant required permissions",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Authorize button in account setup",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Authorize button in account setup",
      "labelEquals": "Authorize",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "OAuth authorization with Launch is required; sign in with your Contentstack account in the popup to grant access."
    },
    {
      "action": "verify",
      "target": "Organization selection field in account setup",
      "labelEquals": "Organization",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Organization selection field in account setup",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any organization option in the Organization selection",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Account Name field in account setup",
      "labelEquals": "Account Name",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Account Name field in account setup",
      "value": "Launch Account",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "launchAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Project lookup field",
      "labelEquals": "Project",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Project lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any project option in the Project lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Environment lookup field",
      "labelEquals": "Environment",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Environment lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any environment option in the Environment lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Action Step card at the bottom of the automation",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card at the bottom of the automation",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Launch connector in the Choose Connector list",
      "labelEquals": "Launch",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Launch connector in the Choose Connector list",
      "labelEquals": "Launch",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Revalidate CDN Cache action option in Choose an Action",
      "labelEquals": "Revalidate CDN Cache",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Revalidate CDN Cache action option in Choose an Action",
      "labelEquals": "Revalidate CDN Cache",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "existing Launch account in account list",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Project lookup field",
      "labelEquals": "Project",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Project lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any project option in the Project lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Environment lookup field",
      "labelEquals": "Environment",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Environment lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any environment option in the Environment lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Revalidate Type dropdown field",
      "labelEquals": "Revalidate Type",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Revalidate Type dropdown",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Path option in the Revalidate Type dropdown",
      "labelEquals": "Path",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Cache Tags option in the Revalidate Type dropdown",
      "labelEquals": "Cache Tags",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Hostnames option in the Revalidate Type dropdown",
      "labelEquals": "Hostnames",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Path option in the Revalidate Type dropdown",
      "labelEquals": "Path",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Revalidation Path field",
      "labelEquals": "Revalidation Path",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Revalidation Path field",
      "value": "/test-path",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Is Prefix checkbox",
      "labelEquals": "Is Prefix",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
