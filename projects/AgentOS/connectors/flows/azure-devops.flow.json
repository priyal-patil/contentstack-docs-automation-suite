{
  "id": "azure-devops",
  "project": "AgentOS",
  "module": "connectors",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/agent-os/azure-devops",
  "type": "executable",
  "use": ["login"],
  "steps": [
    {
      "action": "click",
      "target": "App Switcher icon in the top navigation bar",
      "timeoutMs": 90000,
      "docWarning": "The following prerequisite steps are not described in the document but are required to reach the automation: open App Switcher → navigate to Agent OS → select an existing project → go to Automations → create a new automation (Name + Create) → configure a trigger → open Configure Action Step."
    },
    {
      "action": "verify",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Agent OS in App Switcher list",
      "labelEquals": "Agent OS",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "any existing project card on the projects listing page",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Automations in top navigation panel",
      "labelEquals": "Automations",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "+ New Automation button on the Automations listing page",
      "labelEquals": "+ New Automation",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Automation Name field in the new automation dialog",
      "labelEquals": "Automation Name",
      "labelMatch": "contains"
    },
    {
      "action": "enter",
      "target": "Automation Name field in the new automation dialog",
      "value": "AzureDevOps-{unique5}"
    },
    {
      "action": "verify",
      "target": "Automation Description field",
      "labelEquals": "Description",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Create button in the new automation dialog",
      "labelEquals": "Create",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Configure Action Step in left navigation panel",
      "labelEquals": "Configure Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Action Step card in the automation canvas",
      "labelEquals": "Action Step",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Choose Connector section heading",
      "labelEquals": "Choose Connector",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Azure DevOps connector in the Choose Connector list",
      "labelEquals": "Azure DevOps",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Azure DevOps connector in the Choose Connector list",
      "labelEquals": "Azure DevOps",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "Choose an Action section",
      "labelEquals": "Choose an Action",
      "labelMatch": "contains"
    },
    {
      "action": "verify",
      "target": "Run a Pipeline action option in Choose an Action",
      "labelEquals": "Run a Pipeline",
      "labelMatch": "contains"
    },
    {
      "action": "click",
      "target": "Run a Pipeline action option in Choose an Action",
      "labelEquals": "Run a Pipeline",
      "labelMatch": "contains",
      "timeoutMs": 90000
    },
    {
      "action": "detect",
      "target": "azure-devops-account-selection-state",
      "timeoutMs": 10000
    },
    {
      "action": "click",
      "target": "existing Azure DevOps account in account list",
      "onlyIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists",
      "timeoutMs": 90000
    },
    {
      "action": "verify",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "+ Add New Account button",
      "labelEquals": "+ Add New Account",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists"
    },
    {
      "action": "verify",
      "target": "Title field in account setup",
      "labelEquals": "Title",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Title field in account setup",
      "value": "Azure DevOps Account",
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Access Token field in account setup",
      "labelEquals": "Access Token",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists"
    },
    {
      "action": "enter",
      "target": "Access Token field in account setup",
      "value": "{{AZURE_DEVOPS_ACCESS_TOKEN}}",
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists",
      "warnOnly": true,
      "docWarning": "Real Azure DevOps Personal Access Token is required; generate it from Azure DevOps → User Settings → Personal access tokens with Run & execute (Build) and Read (Project & team) scopes."
    },
    {
      "action": "verify",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists"
    },
    {
      "action": "click",
      "target": "Save button in the account setup form",
      "labelEquals": "Save",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "skipIfFlowFlagTrue": "azureDevOpsAccountAlreadyExists",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Organization Name field",
      "labelEquals": "Organization Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "enter",
      "target": "Organization Name field",
      "value": "my-organization",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Project Name lookup field",
      "labelEquals": "Project Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Project Name lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any project option in the Project Name lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Pipeline Name lookup field",
      "labelEquals": "Pipeline Name",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Pipeline Name lookup field",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "any pipeline option in the Pipeline Name lookup",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Show optional fields toggle button",
      "labelEquals": "Show optional fields",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "YAML Template Parameters field after enabling Show optional fields",
      "labelEquals": "YAML Template Parameters",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Pipeline Version field after enabling Show optional fields",
      "labelEquals": "Pipeline Version",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Resource Data field after enabling Show optional fields",
      "labelEquals": "Resource Data",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Custom Variable field after enabling Show optional fields",
      "labelEquals": "Custom Variable",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Preview Run checkbox after enabling Show optional fields",
      "labelEquals": "Preview Run",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "+ Add Skip Stage button after enabling Show optional fields",
      "labelEquals": "+ Add Skip Stage",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Proceed button",
      "labelEquals": "Proceed",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Test Action button",
      "labelEquals": "Test Action",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "warnOnly": true
    },
    {
      "action": "click",
      "target": "Save and Exit button",
      "labelEquals": "Save and Exit",
      "labelMatch": "contains",
      "timeoutMs": 90000,
      "warnOnly": true
    }
  ]
}
