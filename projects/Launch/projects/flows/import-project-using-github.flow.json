{
  "id": "import-project-using-github",
  "project": "Launch",
  "module": "projects",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/launch/import-project-using-github",
  "type": "executable",
  "use": ["login", "orgDashboard"],
  "automationNotes": "After Import: detect sets launchGithubAlreadyConnected. If GitHub card shows Connected, steps verify/click Connect Account and optional Save/Install are skipped (skipIfFlowFlagTrue). If not connected, those doc steps run. Repository: type react in the Repository async select and pick a matching dropdown row (LAUNCH_REACT_REPO_SEARCH, LAUNCH_REACT_REPO_OPTION_MATCH). Then first Git Branch and Framework Preset options so Deploy enables. Detect launch-import-step2-ui-fields-vs-doc compares Create New Project step-2 labels (data/launch/import-project-github-step2-ui-fields.json) to the live modal and the published doc; gaps are warnings only.",
  "steps": [
    {
      "action": "verify",
      "target": "Launch dashboard entry (doc step)",
      "timeoutMs": 90000,
      "expected": { "labelEquals": "Launch", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Launch dashboard entry (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "+ New Project (doc step)",
      "timeoutMs": 90000,
      "expected": { "labelEquals": "New Project", "labelMatch": "contains" }
    },
    { "action": "click", "target": "+ New Project (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Create New Project modal heading (doc step)",
      "timeoutMs": 90000,
      "expected": { "within": "Modal", "modalTitle": "Create New Project" }
    },
    {
      "action": "verify",
      "target": "Import from a Git Repository (doc step)",
      "expected": { "labelEquals": "Import from a Git Repository", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Import from a Git Repository (doc step)" },
    {
      "action": "detect",
      "target": "launch-github-import-connection-state (doc step)",
      "timeoutMs": 120000
    },
    {
      "action": "verify",
      "target": "Connect Account (doc step)",
      "skipIfFlowFlagTrue": "launchGithubAlreadyConnected",
      "timeoutMs": 90000,
      "expected": { "labelEquals": "Connect Account", "labelMatch": "contains" }
    },
    {
      "action": "click",
      "target": "Connect Account (doc step)",
      "skipIfFlowFlagTrue": "launchGithubAlreadyConnected",
      "timeoutMs": 90000
    },
    {
      "action": "click",
      "target": "GitHub repository access Save (doc step)",
      "skipIfFlowFlagTrue": "launchGithubAlreadyConnected",
      "optional": true
    },
    {
      "action": "click",
      "target": "GitHub Install and Authorize (doc step)",
      "skipIfFlowFlagTrue": "launchGithubAlreadyConnected",
      "optional": true
    },
    {
      "action": "click",
      "target": "GitHub card on Create New Project (doc step)",
      "timeoutMs": 90000
    },

    {
      "action": "verify",
      "target": "Repository field label (doc step)",
      "expected": { "labelEquals": "Repository", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Launch repository Select control (doc step)", "timeoutMs": 90000 },
    {
      "action": "click",
      "target": "Launch import Repository menu type react pick dropdown option (doc step)",
      "timeoutMs": 150000
    },

    {
      "action": "verify",
      "target": "Git Branch field label (doc step)",
      "expected": { "labelEquals": "Git Branch", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Launch Git Branch Select control (doc step)", "timeoutMs": 90000 },
    {
      "action": "click",
      "target": "Launch import Git Branch menu first option (doc step)",
      "timeoutMs": 90000
    },

    {
      "action": "verify",
      "target": "Launch Project Name (doc step)",
      "expected": { "labelEquals": "Project Name", "labelMatch": "contains" }
    },
    {
      "action": "enter",
      "target": "Launch Project Name (doc step)",
      "value": "Auto Launch Project {unique}"
    },

    {
      "action": "verify",
      "target": "Launch Environment Name (doc step)",
      "expected": { "labelEquals": "Environment Name", "labelMatch": "contains" }
    },
    {
      "action": "enter",
      "target": "Launch Environment Name (doc step)",
      "value": "Default"
    },

    {
      "action": "verify",
      "target": "Build and Output Settings section (doc step)",
      "expected": { "labelEquals": "Build and Output Settings", "labelMatch": "contains" }
    },

    {
      "action": "verify",
      "target": "Framework Preset field label (doc step)",
      "expected": { "labelEquals": "Framework Preset", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Launch Framework Preset Select control (doc step)", "timeoutMs": 90000 },
    {
      "action": "click",
      "target": "Launch import Framework Preset menu first option (doc step)",
      "timeoutMs": 90000
    },

    {
      "action": "verify",
      "target": "Build Command field label (doc step)",
      "expected": { "labelEquals": "Build Command", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Launch Build Command input (doc step)",
      "expected": { "labelEquals": "Build Command", "labelMatch": "contains" }
    },

    {
      "action": "verify",
      "target": "Output Directory field label (doc step)",
      "expected": { "labelEquals": "Output Directory", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Launch Output Directory input (doc step)",
      "expected": { "labelEquals": "Output Directory", "labelMatch": "contains" }
    },

    {
      "action": "verify",
      "target": "Environment Variables section (doc step)",
      "expected": { "labelEquals": "Environment Variables", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Key Value Edit tab (doc step)",
      "expected": { "labelEquals": "Key Value Edit", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Key Value Edit tab (doc step)" },
    {
      "action": "verify",
      "target": "Bulk Edit tab (doc step)",
      "expected": { "labelEquals": "Bulk Edit", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "+ Add Environment Variable (doc step)",
      "expected": { "labelEquals": "Add Environment Variable", "labelMatch": "contains" },
      "optional": true
    },

    { "action": "click", "target": "Deploy (doc step)", "timeoutMs": 150000 }
  ]
}
