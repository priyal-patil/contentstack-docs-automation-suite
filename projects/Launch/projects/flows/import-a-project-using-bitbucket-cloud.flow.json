{
  "id": "import-a-project-using-bitbucket-cloud",
  "project": "Launch",
  "module": "projects",
  "stage": "main",
  "source": "https://www.contentstack.com/docs/developers/launch/import-a-project-using-bitbucket-cloud",
  "type": "executable",
  "use": ["login", "orgDashboard"],
  "automationNotes": "Doc-only verifies (https://www.contentstack.com/docs/developers/launch/import-a-project-using-bitbucket-cloud): Launch; New Project; Create New Project modal; Import from a Git Repository; Bitbucket Cloud; Repository; Environment Variables; Build Commands (UI: Build Command); Output Directory; Deploy. Locators for Bitbucket card: data/dom/Launch/bitbucket-cloud.html. All other UI (Git Branch, Project Name, Environment Name, Framework Preset, env-var tabs) is actions only — not named as separate verify steps in this doc. Prerequisites: Bitbucket Marketplace app + OAuth per doc.",
  "steps": [
    {
      "action": "verify",
      "target": "Launch dashboard entry (doc step)",
      "timeoutMs": 90000,
      "expected": { "labelEquals": "Launch", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Launch dashboard entry (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "+ New Project (doc step)",
      "timeoutMs": 90000,
      "expected": { "labelEquals": "New Project", "labelMatch": "contains" }
    },
    { "action": "click", "target": "+ New Project (doc step)", "timeoutMs": 90000 },
    {
      "action": "verify",
      "target": "Create New Project modal heading (doc step)",
      "timeoutMs": 90000,
      "expected": { "within": "Modal", "modalTitle": "Create New Project" }
    },
    {
      "action": "verify",
      "target": "Import from a Git Repository (doc step)",
      "expected": { "labelEquals": "Import from a Git Repository", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Import from a Git Repository (doc step)", "timeoutMs": 120000 },
    {
      "action": "verify",
      "target": "Bitbucket Cloud repository host option (doc step)",
      "timeoutMs": 90000,
      "expected": { "within": "Modal", "labelEquals": "Bitbucket Cloud", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Bitbucket Cloud provider card (doc step)", "timeoutMs": 90000 },

    {
      "action": "verify",
      "target": "Repository field label (doc step)",
      "expected": { "labelEquals": "Repository", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Launch repository Select control (doc step)", "timeoutMs": 90000 },
    {
      "action": "click",
      "target": "Launch import Repository menu first option (doc step)",
      "timeoutMs": 150000
    },

    { "action": "click", "target": "Launch Git Branch Select control (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "Launch import Git Branch menu first option (doc step)", "timeoutMs": 90000 },

    { "action": "enter", "target": "Launch Project Name (doc step)", "value": "Auto Launch Bitbucket {unique5}" },
    { "action": "enter", "target": "Launch Environment Name (doc step)", "value": "Default" },

    { "action": "click", "target": "Launch Framework Preset Select control (doc step)", "timeoutMs": 90000 },
    { "action": "click", "target": "Launch import Framework Preset menu first option (doc step)", "timeoutMs": 90000 },

    {
      "action": "verify",
      "target": "Build Command field label (doc step)",
      "expected": { "labelEquals": "Build Commands", "labelMatch": "contains" },
      "warnOnly": true
    },
    {
      "action": "verify",
      "target": "Output Directory field label (doc step)",
      "expected": { "labelEquals": "Output Directory", "labelMatch": "contains" }
    },
    {
      "action": "verify",
      "target": "Environment Variables section (doc step)",
      "expected": { "labelEquals": "Environment Variables", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Key Value Edit tab (doc step)" },

    {
      "action": "verify",
      "target": "Deploy (doc step)",
      "timeoutMs": 150000,
      "expected": { "within": "Modal", "labelEquals": "Deploy", "labelMatch": "contains" }
    },
    { "action": "click", "target": "Deploy (doc step)", "timeoutMs": 150000 }
  ]
}
