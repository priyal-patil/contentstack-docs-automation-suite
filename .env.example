# Default (prod) profile
CS_APP_ORIGIN=https://app.contentstack.com
CS_EMAIL=your.email@contentstack.com
CS_PASSWORD=your_password
DEFAULT_STACK=YourStackName

# Optional doc auth for protected staging docs
STAG_DOCS_USERNAME=your_docs_username
STAG_DOCS_PASSWORD=your_docs_password

# Slack (scripts/slackFromXlsx.ts, scripts/urlRunSummaryAndSlack.ts) — optional if using encryption_data.xlsx only
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C09GMK1NL14
# ENCRYPTION_SECRET_KEY=same_as_Contentstack_ConfigManager_encryption_secret
# Path to Key/Value workbook (default: ./encryption_data.xlsx). Use absolute path if the file lives elsewhere.
# ENCRYPTION_DATA_XLSX=encryption_data.xlsx
