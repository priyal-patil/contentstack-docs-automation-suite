# Default (prod) profile
CS_APP_ORIGIN=https://app.contentstack.com
CS_EMAIL=your.email@contentstack.com
CS_PASSWORD=your_password
DEFAULT_STACK=YourStackName

# Data & Insights — Lytics DAL flow (create-data-and-insights-lytics-integration): async-select filters.
# CMS Stacks falls back to DEFAULT_STACK when DAL_CMS_STACK_SEARCH is unset; Launch/Personalize pick first menu row if unset (set env to disambiguate).
# DAL_CONFIGURATION_DOMAIN=optional override for domain field (else flow JSON value)
# DAL_CMS_STACK_SEARCH=substring matching a stack in CMS Stacks
# DAL_LAUNCH_PROJECT_SEARCH=substring matching a Launch project (or first visible; set DEFAULT_LAUNCH_PROJECT as alias)
# DEFAULT_LAUNCH_PROJECT=my-launch-project-name
# DAL_PERSONALIZE_PROJECT_SEARCH=substring matching a Personalize project (or first visible)
# PERSONALIZE_PROJECT_CARD_CONTAINS=substring matching a Personalize Projects card heading (manage-personalize-project; fallback Doc Personalize Project)
# DAL_LYTICS_ACCOUNT_SEARCH=optional Lytics account filter (empty = Enter on first option)

# Lytics app — Create Import Entries job + authorization (create-job-and-authorization-for-data-and-insights-lytics)
# Flow opens https://app.lytics.com then sidebar Data Pipeline → Jobs (no LYTICS_PIPELINE_JOBS_URL required).
# Optional override when the Lytics UI is not on prod:
# LYTICS_APP_URL=https://app.lytics.com/
# LYTICS_APP_ORIGIN=https://app.lytics.com
# Deep-link only if you change the flow JSON navigate target to {{LYTICS_PIPELINE_JOBS_URL}}:
# LYTICS_PIPELINE_JOBS_URL=https://app.lytics.com/conductor/pipeline/jobs?aid=...&table=user
# LYTICS_STACK_REGION=North America — must match an option label in the Region dropdown
# LYTICS_JOB_STACK_API_KEY=...   (fallback: LYTICS_STACK_API_KEY)
# LYTICS_JOB_DELIVERY_TOKEN=...  (fallback: LYTICS_DELIVERY_TOKEN)
# LYTICS_JOB_MANAGEMENT_TOKEN=... (fallback: LYTICS_MANAGEMENT_TOKEN)

# Optional: Organization display name for Analytics flows (header org switcher) when the account has multiple orgs
# DEFAULT_ORG=Your Org Name

# Developer Hub — **`Developer Hub doc open any app from listing`** step: substring to match listing row/link (listing page “main”; same as optional **`value`** on that click step). When unset and step has no **`value`**, runner uses heuristic “any app”.
# DEV_HUB_LISTING_APP_NAME=M2188772c

# Row ⋮ menu: after openRowActionMenu, wait before Edit/Settings hover+click (actionRules.ts). Default 2000 if unset.
# VERTICAL_ELLIPSIS_POST_OPEN_MS=2000

# Optional doc auth for protected staging docs
STAG_DOCS_USERNAME=your_docs_username
STAG_DOCS_PASSWORD=your_docs_password

# ----------------------------------------------------------------------------
# Slack (scripts/slackFromXlsx.ts, scripts/urlRunSummaryAndSlack.ts)
# ----------------------------------------------------------------------------
#
# --- GitHub Actions (repository secrets → .env in cms-daily-scheduled.yml) ---
# Optional for summary post after each CMS batch:
#   SLACK_BOT_TOKEN     — Bot User OAuth Token (starts with xoxb-...)
#   SLACK_CHANNEL_ID    — Channel ID (starts with C...), not the channel name
# Failure-only Incoming Webhook (separate step; workflow must fail to fire):
#   SLACK_INCOMING_WEBHOOK_URL — webhook URL from Slack Incoming Webhooks
# On Actions, SKIP_SLACK is unset by default (Slack runs if bot + channel secrets exist).
#
# --- Local .env ---
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C09xxxxxxxxxx   (your workspace channel ID)
# ENCRYPTION_SECRET_KEY=same_as_Contentstack_ConfigManager_encryption_secret
# Path to Key/Value workbook (default: ./encryption_data.xlsx). Use absolute path if the file lives elsewhere.
# ENCRYPTION_DATA_XLSX=encryption_data.xlsx

# ----------------------------------------------------------------------------
# GitHub Actions — daily CMS report email (optional; secrets only — not loaded into local .env)
# ----------------------------------------------------------------------------
# REPORT_EMAIL_TO, REPORT_EMAIL_FROM, REPORT_EMAIL_SMTP_HOST,
# REPORT_EMAIL_SMTP_USERNAME, REPORT_EMAIL_SMTP_PASSWORD,
# REPORT_EMAIL_SMTP_PORT (optional; default 587 in workflow)
# See README "Daily report email (SMTP)".
