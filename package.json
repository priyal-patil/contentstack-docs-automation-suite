{
  "name": "contentstack-ai-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:stable": "PW_WORKERS=1 PW_SLOWMO=200 playwright test",
    "test:ui": "playwright test --ui",
    "test:cms": "playwright test tests/flows.spec.ts -g \"Project=CMS\"",
    "test:cms:headless:report": "bash scripts/run-cms-headless-report.sh",
    "report:cms:excel": "ts-node scripts/generateCmsExcelReport.ts",
    "report:cms:dashboard": "ts-node scripts/generateCmsDashboardHtml.ts",
    "report:cms:bundle": "ts-node scripts/buildCmsReportBundle.ts",
    "test:cms:content-models": "playwright test tests/flows.spec.ts -g \"Project=CMS Module=content-models\"",
    "test:cms:delete-urls": "playwright test tests/flows.spec.ts -g \"Project=CMS.*Stage=(delete|cleanup)\"",
    "test:launch": "playwright test tests/flows.spec.ts -g \"Project=Launch\"",
    "test:personalize": "playwright test tests/flows.spec.ts -g \"Project=Personalize\"",
    "ingest:docs": "ts-node scripts/ingestDocs.ts --input data/ingest.json",
    "ingest:bulk": "ts-node scripts/bulkIngestFromUrls.ts --input data/bulk-urls.json",
    "ingest-and-run": "npm run ingest:bulk -- --input data/bulk-urls.csv && npm run test:all-and-report",
    "run:bulk": "ts-node scripts/runBulkFromCsv.ts --input data/Bulk-urls-Sheet1-corrected.csv",
    "intake:urls": "ts-node tools/intake-urls.ts",
    "test:docs": "playwright test tests/docs.spec.ts",
    "test:docs-audit": "playwright test tests/docs-audit.spec.ts",
    "test:docs-audit:headed": "playwright test tests/docs-audit.spec.ts --headed",
    "test:docs-audit:dashboard": "playwright test tests/docs-audit.spec.ts; npm run report:dashboard && open reports/latest/dashboard.html",
    "sync:docs-urls": "ts-node scripts/syncDocsUrlsToCsv.ts",
    "add-doc-url": "ts-node scripts/addDocUrlToCsv.ts",
    "test:flows": "playwright test tests/flows.spec.ts",
    "test:flows:dev14": "ENV_FILE=.env.dev14 FORCE_RELOGIN=true playwright test tests/flows.spec.ts",
    "test:flows:prod": "FORCE_RELOGIN=true playwright test tests/flows.spec.ts",
    "test:crawl": "playwright test tests/crawl/crawl.spec.ts --project=crawl",
    "crawl": "ts-node scripts/runCrawl.ts",
    "crawl:dashboard": "ts-node scripts/generateCrawlDashboard.ts",
    "crawl:open": "npm run crawl:dashboard && open reports/crawl-dashboard/dashboard.html",
    "test:all": "playwright test tests/docs.spec.ts tests/flows.spec.ts",
    "report:merge": "ts-node core/report/mergeResults.ts",
    "report:dashboard": "ts-node scripts/generateDashboardReport.ts",
    "report:unified": "ts-node scripts/generateUnifiedReport.ts",
    "test:all-and-report": "npm run sync:docs-urls && playwright test tests/flows.spec.ts tests/docs-audit.spec.ts; npm run report:dashboard",
    "test:all-and-report:notify": "npm run test:all-and-report && open reports/latest/dashboard.html && osascript -e 'display notification \"Dashboard: reports/latest/dashboard.html\" with title \"Automation run finished\"'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "pixelmatch": "^7.1.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.3",
    "openai": "^6.22.0"
  }
}
