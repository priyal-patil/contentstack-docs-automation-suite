{
  "name": "contentstack-ai-automation",
  "version": "1.0.0",
  "description": "Contentstack Docs Automation Suite",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:agentos": "bash scripts/run-agentos-headless.sh",
    "test:agentos:agent-os": "OPEN_FLOW_REPORT=false PW_RETRIES=3 playwright test tests/flows.spec.ts --project=flows --grep=\"Project=AgentOS Module=agent-os\"",
    "test:agentos:agents": "OPEN_FLOW_REPORT=false PW_RETRIES=3 playwright test tests/flows.spec.ts --project=flows --grep=\"Project=AgentOS Module=agents\"",
    "test:agentos:automations": "bash scripts/run-agentos-automations-headless.sh",
    "test:stable": "PW_WORKERS=1 PW_SLOWMO=200 playwright test",
    "test:label-match-unit": "ts-node --transpile-only tests/unit/labelMatch.unit.ts",
    "test:ui": "playwright test --ui",
    "codegen": "playwright codegen --load-storage=auth.json",
    "codegen:app": "bash scripts/playwright-codegen-app.sh",
    "test:cms": "bash scripts/run-cms-headless-background.sh",
    "test:cms:headed": "PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed",
    "test:flows:headed:long10m": "PW_FLOW_MAX_MINUTES=10 PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed",
    "test:devhub:marketplace-ecommerce-app-boilerplate:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-45} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"marketplace-ecommerce-app-boilerplate\"",
    "test:devhub:marketplace-dam-app-boilerplate:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-60} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"marketplace-dam-app-boilerplate\"",
    "test:devhub:create-apps:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-60} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"Project=Developer-Hub Module=create-apps Stage=main\"",
    "test:devhub:ui-locations:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-60} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"Project=Developer-Hub Module=ui-locations Stage=main\"",
    "test:devhub:sidebar-location:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-60} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g '(?<!-)sidebar-location$'",
    "test:flows:fast-fail": "FAST_FAIL=1 playwright test tests/flows.spec.ts --project=flows",
    "test:launch:redeploy:headed:fast": "FAST_FAIL=1 PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"redeploy-automatically-when-content-is-published-on-cms\"",
    "test:cms:sequential-modules": "bash scripts/run-cms-sequential-modules-dashboard.sh",
    "test:cms:batch1": "bash scripts/run-cms-batch1.sh",
    "test:cms:batch1:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-batch1.sh",
    "test:cms:batch2": "bash scripts/run-cms-batch2.sh",
    "test:cms:batch2:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-batch2.sh",
    "test:cms:batch3": "bash scripts/run-cms-batch3.sh",
    "test:cms:batch3:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-batch3.sh",
    "test:cms:webhook": "bash scripts/run-cms-webhook.sh",
    "test:cms:webhook:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-webhook.sh",
    "test:cms:releases": "bash scripts/run-cms-releases.sh",
    "test:cms:releases:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-releases.sh",
    "test:cms:live-preview": "bash scripts/run-cms-live-preview.sh",
    "test:cms:live-preview:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-live-preview.sh",
    "test:cms:full": "bash scripts/run-cms-batch1.sh; bash scripts/run-cms-batch2.sh; bash scripts/run-cms-batch3.sh",
    "test:cms:full:headed": "PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-batch1.sh; PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-batch2.sh; PLAYWRIGHT_HEADLESS=0 bash scripts/run-cms-batch3.sh",
    "launch:cms:bg": "bash scripts/run-project-batch-background.sh CMS",
    "launch:launch:bg": "bash scripts/run-project-batch-background.sh Launch",
    "launch:personalize:bg": "bash scripts/run-project-batch-background.sh Personalize",
    "launch:data-and-insights:bg": "bash scripts/run-project-batch-background.sh Data-and-Insights",
    "launch:cms-launch-studio:bg": "bash scripts/run-cms-launch-studio-combined-background.sh",
    "run:cms-launch-studio": "bash scripts/run-cms-launch-studio-combined-background.sh",
    "run:cms": "bash scripts/run-project-batch-background.sh CMS",
    "run:launch": "bash scripts/run-project-batch-background.sh Launch",
    "run:personalize": "bash scripts/run-project-batch-background.sh Personalize",
    "run:data-and-insights": "bash scripts/run-project-batch-background.sh Data-and-Insights",
    "test:cms:headless:report": "bash scripts/run-cms-headless-background.sh",
    "test:cms:foreground": "bash scripts/run-cms-headless-report.sh",
    "report:cms:excel": "ts-node scripts/generateCmsExcelReport.ts",
    "report:cms:dashboard": "ts-node scripts/generateCmsDashboardHtml.ts",
    "report:cms:bundle": "ts-node scripts/buildCmsReportBundle.ts",
    "test:cms:content-models": "CMS_SEQUENTIAL_MODULE_ORDER=1 CMS_CONTINUE_ON_FAIL=1 playwright test tests/flows.spec.ts --project=flows -g \"Project=CMS Module=content-models Stage=main\" --grep-invert delete-content-type",
    "test:cms:delete-urls": "playwright test tests/flows.spec.ts --project=flows -g \"Project=CMS.*Stage=(delete|cleanup)\"",
    "test:launch": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-15} playwright test tests/flows.spec.ts --project=flows -g \"Project=Launch\"; npm run report:slack",
    "test:administration": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-15} playwright test tests/flows.spec.ts --project=flows -g \"Project=Administration\"; npm run report:slack",
    "test:personalize": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-15} playwright test tests/flows.spec.ts --project=flows -g \"Project=Personalize\"; npm run report:slack",
    "test:personalize:edit-custom-attribute:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"edit-custom-attribute\"",
    "test:personalize:create-event:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"create-event\"",
    "test:personalize:edit-event:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"edit-event\"",
    "test:personalize:user-permissions-invite-user:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"user-permissions-invite-user\"",
    "test:personalize:add-event-to-ab-test-experience:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-25} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"add-event-to-ab-test-experience\"",
    "test:personalize:edit-audience:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"edit-audience\"",
    "test:personalize:delete-audience:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"delete-audience\"",
    "test:personalize:delete-experience:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"delete-experience\"",
    "test:personalize:delete-event:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-20} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"delete-event\"",
    "test:personalize:prioritize-experiences:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-25} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"prioritize-experiences\"",
    "test:data-and-insights": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-15} playwright test tests/flows.spec.ts --project=flows -g \"Project=Data-and-Insights\"; npm run report:slack",
    "test:data-and-insights:lytics-integration:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-25} PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"create-data-and-insights-lytics-integration\"",
    "test:data-and-insights:lytics-job-auth:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-25} PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"create-job-and-authorization-for-data-and-insights-lytics\"",
    "test:data-and-insights:event-tracking-launch:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-25} PW_WORKERS=1 playwright test tests/flows.spec.ts --project=flows --headed -g \"event-tracking-in-contentstack-launch\"",
    "test:data-and-insights:dal-then-lytics-job:headed": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-60} PLAYWRIGHT_HEADLESS=0 PW_WORKERS=1 playwright test --project=data-insights-chain tests/data-and-insights-lytics-dal-then-job.spec.ts",
    "ingest:docs": "ts-node scripts/ingestDocs.ts --input data/ingest.json",
    "ingest:bulk": "ts-node scripts/bulkIngestFromUrls.ts --input data/bulk-urls.json",
    "ingest-and-run": "npm run ingest:bulk -- --input data/bulk-urls.csv && npm run test:all-and-report",
    "run:bulk": "ts-node scripts/runBulkFromCsv.ts --input data/Bulk-urls-Sheet1-corrected.csv",
    "intake:urls": "ts-node tools/intake-urls.ts",
    "test:docs": "playwright test tests/docs.spec.ts",
    "test:docs-audit": "playwright test tests/docs-audit.spec.ts",
    "test:docs-audit:cms": "DOCS_AUDIT_PROJECT=CMS playwright test tests/docs-audit.spec.ts --project=docs-audit --grep \"Audit:\" && PW_WORKERS=1 DOCS_AUDIT_PROJECT=CMS playwright test tests/docs-audit.spec.ts --project=docs-audit --grep \"Docs Audit Summary\"",
    "test:docs-audit:launch": "DOCS_AUDIT_PROJECT=Launch DOCS_URLS_CSV=data/launch-urls.csv playwright test tests/docs-audit.spec.ts --project=docs-audit",
    "test:docs-audit:personalize": "DOCS_AUDIT_PROJECT=Personalize playwright test tests/docs-audit.spec.ts --project=docs-audit",
    "docs-audit:bg": "bash scripts/run-docs-audit-background.sh",
    "test:docs-audit:headed": "playwright test tests/docs-audit.spec.ts --headed",
    "test:docs-audit:dashboard": "playwright test tests/docs-audit.spec.ts; npm run report:dashboard && open reports/latest/dashboard.html",
    "sync:docs-urls": "ts-node scripts/syncDocsUrlsToCsv.ts",
    "build:launch-urls": "ts-node scripts/buildLaunchUrlsCsv.ts",
    "add-doc-url": "ts-node scripts/addDocUrlToCsv.ts",
    "test:flows": "playwright test tests/flows.spec.ts --project=flows; npm run report:slack",
    "test:flows:dev14": "ENV_FILE=.env.dev14 FORCE_RELOGIN=true playwright test tests/flows.spec.ts --project=flows",
    "test:flows:prod": "FORCE_RELOGIN=true playwright test tests/flows.spec.ts --project=flows",
    "test:crawl": "playwright test tests/crawl/crawl.spec.ts --project=crawl",
    "crawl": "ts-node scripts/runCrawl.ts",
    "crawl:dashboard": "ts-node scripts/generateCrawlDashboard.ts",
    "crawl:open": "npm run crawl:dashboard && open reports/crawl-dashboard/dashboard.html",
    "test:all": "PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-15} playwright test tests/docs.spec.ts tests/flows.spec.ts --project=default --project=flows",
    "report:merge": "ts-node core/report/mergeResults.ts",
    "report:dashboard": "ts-node scripts/generateDashboardReport.ts",
    "report:unified": "ts-node scripts/generateUnifiedReport.ts",
    "report:slack": "ts-node scripts/urlRunSummaryAndSlack.ts",
    "test:all-and-report": "npm run sync:docs-urls && PW_FLOW_MAX_MINUTES=${PW_FLOW_MAX_MINUTES:-15} playwright test tests/flows.spec.ts tests/docs-audit.spec.ts --project=flows --project=docs-audit; npm run report:dashboard; npm run report:slack",
    "test:all-and-report:notify": "npm run test:all-and-report && open reports/latest/dashboard.html && osascript -e 'display notification \"Dashboard: reports/latest/dashboard.html\" with title \"Automation run finished\"'",
    "slack:ping": "ts-node scripts/slackFromXlsx.ts",
    "slack:test": "ts-node scripts/urlRunSummaryAndSlack.ts --slack-test",
    "slack:url-summary": "ts-node scripts/urlRunSummaryAndSlack.ts",
    "slack:url-summary:dry": "ts-node scripts/urlRunSummaryAndSlack.ts --dry-run",
    "slack:cms-report": "bash -c 'npx ts-node scripts/urlRunSummaryAndSlack.ts --reportDir \"${REPORT_DIR:-$(cat reports/latest-cms-batch-dir.txt)}\"'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "pixelmatch": "^7.1.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.3",
    "openai": "^6.22.0"
  }
}
